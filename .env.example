# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL pública fixa da aplicação — usada para montar links enviados por
# e-mail (ex: redefinição de senha), em vez de confiar no header Host
# da requisição (que um proxy mal configurado pode repassar sem validar).
APP_URL=http://localhost:3000

# ── Banco de dados (Clever Cloud MySQL, ou qualquer MySQL 8) ──
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── GitHub OAuth App ───────────────────────────────────────
# Criar em: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Sessão ─────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── E-mail transacional (recuperação de senha) ─────────────
# Sem essas variáveis, "Esqueci minha senha" continua respondendo
# com sucesso genérico (não vaza quais e-mails existem), mas o
# e-mail de fato não é enviado — só um log de erro no servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ápice <no-reply@apice.app>

# ── Bootstrap da conta administradora ───────────────────────
# Não existe cadastro público de admin. Rode `node database/seed-admin.js`
# uma vez com essas variáveis definidas para criar a primeira conta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# ── Anthropic (Claude) — funcionalidades de IA ──────────────
# Criar chave em: https://console.anthropic.com/settings/keys
# Sem ANTHROPIC_API_KEY definida, as funcionalidades de IA falham de
# forma isolada (erro logado no servidor) — o resto da plataforma
# continua funcionando normalmente.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
