<%#
  header-company.ejs — Navbar superior da área da empresa
  Requer locals: user, currentPage
  CSS: /css/header.css
  currentPage: 'empresa-dashboard' | 'empresa-vagas' | 'empresa-devs' | 'empresa-matchs' | 'perfil'
%>

<a class="skip-link" href="#main-content">Ir para o conteúdo</a>

<header class="site-header site-header--company" id="site-header" role="banner">

  <%# ── Logo + nome da empresa ─────────────────── %>
  <a href="/empresa/dashboard" class="site-logo" aria-label="Ápice — painel da empresa">
    <img src="/images/principal.webp" alt="Ápice" class="nav-logo__img"
         width="90" height="22" loading="eager" />
    <% if (locals.user && (user.company || user.name)) { %>
      <span class="site-logo__divider" aria-hidden="true">/</span>
      <span class="site-logo__company"><%= user.company || user.name %></span>
    <% } %>
  </a>

  <%# ── Nav Desktop ────────────────────────────── %>
  <nav class="header-nav" aria-label="Navegação da empresa">

    <a href="/empresa/dashboard"
       class="header-link<% if (locals.currentPage === 'empresa-dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-dashboard') { %>aria-current="page"<% } %>>
      Dashboard
    </a>

    <a href="/empresa/vagas"
       class="header-link<% if (locals.currentPage === 'empresa-vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-vagas') { %>aria-current="page"<% } %>>
      Vagas
    </a>

    <a href="/empresa/desenvolvedores"
       class="header-link<% if (locals.currentPage === 'empresa-devs') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-devs') { %>aria-current="page"<% } %>>
      Desenvolvedores
    </a>

    <a href="/empresa/matchs"
       class="header-link<% if (locals.currentPage === 'empresa-matchs') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-matchs') { %>aria-current="page"<% } %>>
      Matchs
    </a>

  </nav>

  <%# ── Direita: user menu + hamburger ───────── %>
  <div class="header-right">

    <% if (locals.user) { %>
    <a href="/empresa/mensagens" class="header-msg-btn header-msg-btn--company" aria-label="Mensagens" id="headerMsgBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="header-msg-badge" id="headerMsgBadge" hidden>0</span>
    </a>
    <div class="header-user">
      <div class="user-menu">
        <button class="user-menu-btn" id="userMenuBtn" type="button"
                aria-haspopup="true" aria-expanded="false"
                aria-controls="userMenuList" aria-label="Menu da empresa">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>" alt="" class="header-avatar header-avatar--company"
                 width="26" height="26" loading="lazy" aria-hidden="true"/>
          <% } else { %>
            <span class="header-avatar-placeholder header-avatar-placeholder--company" aria-hidden="true">
              <%= (user.company || user.name || 'E').charAt(0).toUpperCase() %>
            </span>
          <% } %>
          <span class="header-username"><%= (user.company || user.name || 'Empresa').split(' ')[0] %></span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <ul class="user-menu-list user-menu-list--company" id="userMenuList" role="menu" hidden>
          <li role="none">
            <a role="menuitem" href="/empresa/perfil">Perfil da empresa</a>
          </li>
          <li role="none">
            <a role="menuitem" href="/empresa/vagas">Gerenciar vagas</a>
          </li>
          <li role="separator" class="menu-divider" aria-hidden="true"></li>
          <li role="none">
            <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="dark-mode"
                    aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
          </li>
          <li role="none">
            <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="high-contrast"
                    aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
          </li>
          <li role="separator" class="menu-divider" aria-hidden="true"></li>
          <li role="none">
            <a role="menuitem" href="/auth/logout" class="menu-item--danger">Sair</a>
          </li>
        </ul>
      </div>
    </div>
    <% } %>

    <%# ── Botão hamburger (aparece só no mobile) %>
    <button class="hamburger-btn" id="hamburgerBtn" type="button"
            aria-label="Abrir menu de navegação" aria-expanded="false"
            aria-controls="mobileDrawer">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

  </div>

</header>

<%# ═══ Mobile Drawer (empresa — teal) ════════ %>
<div class="mobile-drawer mobile-drawer--company" id="mobileDrawer"
     role="dialog" aria-modal="true" aria-label="Menu de navegação" aria-hidden="true">

  <div class="drawer-head">
    <a href="/empresa/dashboard" class="site-logo" tabindex="-1" aria-hidden="true">
      <img src="/images/principal.webp" alt="Ápice" height="22" width="90" loading="eager" />
    </a>
    <button class="drawer-close-btn" id="drawerClose" type="button" aria-label="Fechar menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navegação da empresa">

    <a href="/empresa/dashboard"
       class="drawer-link<% if (locals.currentPage === 'empresa-dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-dashboard') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      Dashboard
    </a>

    <a href="/empresa/vagas"
       class="drawer-link<% if (locals.currentPage === 'empresa-vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-vagas') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="7" width="20" height="14" rx="2"/>
        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
        <line x1="12" y1="12" x2="12" y2="16"/>
        <line x1="10" y1="14" x2="14" y2="14"/>
      </svg>
      Vagas
    </a>

    <a href="/empresa/desenvolvedores"
       class="drawer-link<% if (locals.currentPage === 'empresa-devs') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-devs') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      Desenvolvedores
    </a>

    <a href="/empresa/matchs"
       class="drawer-link<% if (locals.currentPage === 'empresa-matchs') { %> is-active<% } %>"
       <% if (locals.currentPage === 'empresa-matchs') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      Matchs
    </a>

  </nav>

  <% if (locals.user) { %>
  <div class="drawer-foot">
    <div class="drawer-user">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="" class="drawer-avatar drawer-avatar--company"
             width="36" height="36" loading="lazy" />
      <% } else { %>
        <span class="drawer-avatar-ph drawer-avatar-ph--company">
          <%= (user.company || user.name || 'E').charAt(0).toUpperCase() %>
        </span>
      <% } %>
      <div class="drawer-user-info">
        <span class="drawer-user-name"><%= user.company || user.name || user.email %></span>
        <span class="drawer-user-role">Empresa</span>
      </div>
    </div>
    <div class="drawer-foot-links">
      <a href="/empresa/perfil" class="drawer-foot-link">Perfil da empresa</a>
      <a href="/empresa/vagas" class="drawer-foot-link">Gerenciar vagas</a>
      <button type="button" class="drawer-foot-link" data-a11y="dark-mode"
              aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
      <button type="button" class="drawer-foot-link" data-a11y="high-contrast"
              aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
      <a href="/auth/logout" class="drawer-foot-link drawer-foot-link--danger">Sair da conta</a>
    </div>
  </div>
  <% } %>

</div>

<%# ═══ Overlay ═══════════════════════════════ %>
<div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>

<%# ═══ Bottom Nav Mobile (pill — empresa) ═════ %>
<nav class="bottom-nav bottom-nav--company" aria-label="Navegação da empresa">

  <a href="/empresa/dashboard"
     class="bottom-nav-item<% if (locals.currentPage === 'empresa-dashboard') { %> is-active<% } %>"
     <% if (locals.currentPage === 'empresa-dashboard') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="14" width="7" height="7" rx="1.5"/>
      <rect x="3" y="14" width="7" height="7" rx="1.5"/>
    </svg>
    <span>Home</span>
  </a>

  <a href="/empresa/vagas"
     class="bottom-nav-item<% if (locals.currentPage === 'empresa-vagas') { %> is-active<% } %>"
     <% if (locals.currentPage === 'empresa-vagas') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="7" width="20" height="14" rx="2"/>
      <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
      <line x1="12" y1="12" x2="12" y2="16"/>
      <line x1="10" y1="14" x2="14" y2="14"/>
    </svg>
    <span>Vagas</span>
  </a>

  <a href="/empresa/desenvolvedores"
     class="bottom-nav-item<% if (locals.currentPage === 'empresa-devs') { %> is-active<% } %>"
     <% if (locals.currentPage === 'empresa-devs') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
    <span>Devs</span>
  </a>

  <a href="/empresa/matchs"
     class="bottom-nav-item<% if (locals.currentPage === 'empresa-matchs') { %> is-active<% } %>"
     <% if (locals.currentPage === 'empresa-matchs') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span>Matchs</span>
  </a>

  <a href="/empresa/perfil"
     class="bottom-nav-item<% if (locals.currentPage === 'perfil') { %> is-active<% } %>"
     <% if (locals.currentPage === 'perfil') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="7" width="20" height="14" rx="2"/>
      <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
      <circle cx="12" cy="14" r="3"/>
    </svg>
    <span>Perfil</span>
  </a>

</nav>

<script>
(function () {
  // ── Dropdown do usuário ──────────────────────
  const menuBtn  = document.getElementById('userMenuBtn');
  const menuList = document.getElementById('userMenuList');

  function closeMenu() {
    if (!menuBtn || !menuList) return;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuList.hidden = true;
  }
  function openMenu() {
    menuBtn.setAttribute('aria-expanded', 'true');
    menuList.hidden = false;
    menuList.querySelector('[role="menuitem"]')?.focus();
  }

  if (menuBtn && menuList) {
    menuBtn.addEventListener('click', () =>
      menuBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
    );
    document.addEventListener('click', e => {
      if (!menuBtn.contains(e.target) && !menuList.contains(e.target)) closeMenu();
    });
  }

  // ── Mobile drawer ────────────────────────────
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const drawer       = document.getElementById('mobileDrawer');
  const overlay      = document.getElementById('drawerOverlay');
  const closeBtn     = document.getElementById('drawerClose');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    hamburgerBtn.classList.add('is-active');
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    hamburgerBtn?.classList.remove('is-active');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', () =>
    hamburgerBtn.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer()
  );
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeMenu(); closeDrawer(); }
  });

  // ── Badge de mensagens não lidas ──────────────
  const msgBadge = document.getElementById('headerMsgBadge');
  if (msgBadge) {
    fetch('/api/messages/unread-count')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (!data || !data.count) return;
        msgBadge.textContent = data.count > 99 ? '99+' : data.count;
        msgBadge.hidden = false;
      })
      .catch(() => {});
  }
})();
</script>
<script src="/js/accessibility.js" defer></script>
