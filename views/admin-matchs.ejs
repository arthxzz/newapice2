<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Monitoramento do algoritmo de compatibilidade — Ápice." />
  <title>Ápice — Admin · Matchs</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/empresa-dashboard.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-matchs' }) %>

<main class="page-content" id="main-content">

  <section class="loading-screen" id="loading" role="status" aria-live="polite">
    <span class="spinner" aria-hidden="true"></span>
    <p>Carregando matchs...</p>
  </section>

  <article id="content" hidden>

    <ul class="metrics-grid" aria-label="Resumo de ações de match">
      <li class="metric-card">
        <span class="metric-icon ic-green">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <strong class="metric-val" id="m-aceitos" style="color:var(--accent)">—</strong>
        <p class="metric-lbl">Matchs aceitos</p>
      </li>
      <li class="metric-card">
        <span class="metric-icon ic-yellow">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </span>
        <strong class="metric-val" id="m-recusados">—</strong>
        <p class="metric-lbl">Matchs recusados</p>
      </li>
      <li class="metric-card">
        <span class="metric-icon ic-blue">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </span>
        <strong class="metric-val" id="m-total">—</strong>
        <p class="metric-lbl">Ações registradas</p>
      </li>
    </ul>

    <section class="section" aria-label="Melhores matchs da plataforma">
      <header class="section-header">
        <h1 class="section-title">Top matchs (score ≥ 70%)</h1>
      </header>
      <figure class="jobs-table-wrap">
        <table class="jobs-table" aria-label="Melhores compatibilidades dev × vaga">
          <thead>
            <tr><th scope="col">Desenvolvedor</th><th scope="col">Vaga</th><th scope="col">Empresa</th><th scope="col">Score</th></tr>
          </thead>
          <tbody id="top-matches-tbody"></tbody>
        </table>
        <section class="table-empty" id="top-matches-empty" hidden>
          <p class="table-empty-title">Nenhum match acima de 70% no momento</p>
          <p class="table-empty-sub">Isso muda conforme devs completam skills e empresas publicam vagas.</p>
        </section>
      </figure>
    </section>

  </article>
</main>

<footer class="site-footer">
  <p>&copy; <script>document.write(new Date().getFullYear())</script> Ápice. Painel do administrador.</p>
</footer>

<script>
async function init() {
  try {
    const res = await fetch("/api/admin/matches");
    if (!res.ok) throw new Error("Falha ao carregar dados");
    const data = await res.json();

    document.getElementById("m-aceitos").textContent   = data.actions.aceitos;
    document.getElementById("m-recusados").textContent = data.actions.recusados;
    document.getElementById("m-total").textContent     = data.actions.total;

    const tbody = document.getElementById("top-matches-tbody");
    const empty = document.getElementById("top-matches-empty");
    tbody.innerHTML = "";

    if (!data.topMatches.length) {
      empty.hidden = false;
    } else {
      empty.hidden = true;
      data.topMatches.forEach(m => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td data-label="Desenvolvedor">${m.dev}${m.github ? ` <span class="job-company-level">@${m.github}</span>` : ""}</td>
          <td data-label="Vaga">${m.job}</td>
          <td data-label="Empresa">${m.company ?? "—"}</td>
          <td data-label="Score"><span class="badge badge-green">${m.score}%</span></td>`;
        tbody.appendChild(tr);
      });
    }

    document.getElementById("loading").hidden = true;
    document.getElementById("content").hidden = false;
  } catch (err) {
    console.error(err);
    document.getElementById("loading").innerHTML = `
      <section style="text-align:center">
        <p style="color:var(--red);margin-bottom:10px">Erro ao carregar os matchs.</p>
        <a href="/admin/dashboard" style="color:var(--blue);font-size:.9rem">← Voltar ao painel</a>
      </section>`;
  }
}

init();
</script>

</body>
</html>
