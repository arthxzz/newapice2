<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Entre na sua conta Ápice e descubra vagas sob medida para o seu perfil." />
  <title>Ápice — Entrar</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<body class="login-page">

  <div class="lp-layout">

    <!-- Barra superior: logo + linha de brilho -->
    <header class="lp-header">
      <a href="/" class="lp-logo" aria-label="Ápice — Página inicial">
        <img src="/images/principal.webp" alt="Ápice" height="26" loading="eager" />
      </a>
    </header>

    <main class="lp-left" aria-label="Formulário de acesso">
      <div class="lp-left-inner">

        <!-- Boas-vindas -->
        <header class="lp-welcome">
          <span class="lp-eyebrow" aria-hidden="true">
            <span class="lp-eyebrow-dot"></span>
            Plataforma de carreiras em tech
          </span>
          <h1 id="card-title">Bem-vindo de volta</h1>
          <p id="card-subtitle">Entre na sua conta para continuar</p>
        </header>

        <!-- Tabs: Desenvolvedor / Empresa -->
        <div class="type-tabs" role="tablist" aria-label="Tipo de acesso">
          <button type="button" class="tab-btn active" role="tab" aria-selected="true"
                  data-type="dev" id="tab-dev">
            <span class="tab-icon" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
              </svg>
            </span>
            Desenvolvedor
          </button>
          <button type="button" class="tab-btn" role="tab" aria-selected="false"
                  data-type="empresa" id="tab-empresa">
            <span class="tab-icon" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </span>
            Empresa
          </button>
        </div>

        <!-- Alerta (erros / sucesso) -->
        <output class="alert" id="alert" role="alert" aria-live="assertive"></output>

        <!-- Bloco GitHub (só para devs) -->
        <div class="github-block" id="github-block">
          <a href="/auth/github" class="btn-github" aria-label="Entrar com GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Continuar com GitHub
          </a>
          <p class="divider" role="separator"><span>ou entre com e-mail</span></p>
        </div>

        <!-- Formulário -->
        <form id="form" novalidate>

          <!-- E-mail -->
          <fieldset class="field">
            <label for="email">E-mail</label>
            <div class="field-wrap">
              <svg class="field-ico" width="15" height="15" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round"
                   stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <input type="email" id="email" name="email" placeholder="seu@email.com"
                     autocomplete="email" inputmode="email" required
                     aria-describedby="email-err" aria-invalid="false" />
            </div>
            <span class="field-error" id="email-err" role="alert">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
              Informe um e-mail válido.
            </span>
          </fieldset>

          <!-- Senha -->
          <fieldset class="field">
            <div class="field-label-row">
              <label for="password">Senha</label>
              <a href="/esqueci-senha" class="forgot-link">Esqueci minha senha</a>
            </div>
            <div class="pass-wrap field-wrap">
              <svg class="field-ico" width="15" height="15" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round"
                   stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input type="password" id="password" name="password" placeholder="••••••••"
                     autocomplete="current-password" required
                     aria-describedby="pass-err" aria-invalid="false" />
              <button type="button" class="toggle-pass" id="toggle-pass"
                      aria-label="Mostrar senha" onclick="togglePass('password', this)">
                <svg id="icon-eye" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <svg id="icon-eye-off" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true" style="display:none">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                  <line x1="1" y1="1" x2="23" y2="23"/>
                </svg>
              </button>
            </div>
            <span class="field-error" id="pass-err" role="alert">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
              Informe sua senha.
            </span>
          </fieldset>

          <button type="submit" class="btn-submit" id="btn">Entrar na plataforma</button>

        </form>

        <!-- Link: criar conta -->
        <p class="card-footer" id="card-footer">
          Ainda não tem conta? <a href="/cadastro">Criar conta grátis</a>
        </p>

      </div>

    </main>

  </div>

  <script>
    const getEl = id => document.getElementById(id);

    // ── Tab state ──────────────────────────────────────────────
    let currentType = "dev";

    const tabConfig = {
      dev: {
        title:    "Bem-vindo de volta",
        subtitle: "Entre na sua conta para continuar",
        btnText:  "Entrar na plataforma",
        footer:   `Ainda não tem conta? <a href="/cadastro">Criar conta grátis</a>`,
      },
      empresa: {
        title:    "Acesso Empresa",
        subtitle: "Entre com sua conta empresarial",
        btnText:  "Entrar na plataforma",
        footer:   `Ainda não tem conta? <a href="/cadastro#empresa">Cadastrar empresa</a>`,
      },
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Troca o conteúdo de um elemento com uma saída/entrada lateral (dir: 1 = dev→empresa, -1 = inverso)
    function swapContent(el, update, dir) {
      if (reduceMotion || !el.animate) { update(); return; }
      const out = el.animate(
        [{ opacity: 1, transform: "translateX(0)" }, { opacity: 0, transform: `translateX(${-dir * 16}px)` }],
        { duration: 160, easing: "ease-in", fill: "forwards" }
      );
      out.finished.then(() => {
        update();
        out.cancel();
        el.animate(
          [{ opacity: 0, transform: `translateX(${dir * 16}px)` }, { opacity: 1, transform: "translateX(0)" }],
          { duration: 240, easing: "ease-out" }
        );
      }).catch(() => update());
    }

    // Mostra/esconde o bloco do GitHub recolhendo a altura, sem "pulo" no layout
    function toggleGithub(show) {
      const el = getEl("github-block");
      if (reduceMotion || !el.animate) { el.hidden = !show; return; }
      el.style.overflow = "hidden";
      if (show) {
        el.hidden = false;
        const h = el.scrollHeight;
        el.animate(
          [{ opacity: 0, height: "0px" }, { opacity: 1, height: h + "px" }],
          { duration: 280, easing: "ease-out" }
        ).finished.then(() => { el.style.overflow = ""; }).catch(() => { el.style.overflow = ""; });
      } else {
        const h = el.offsetHeight;
        const a = el.animate(
          [{ opacity: 1, height: h + "px" }, { opacity: 0, height: "0px" }],
          { duration: 240, easing: "ease-in", fill: "forwards" }
        );
        a.finished.then(() => {
          if (currentType === "empresa") el.hidden = true;
          a.cancel();
          el.style.overflow = "";
        }).catch(() => { el.style.overflow = ""; });
      }
    }

    function switchTab(type, animate = true) {
      if (type === currentType && animate) return;
      const dir = type === "empresa" ? 1 : -1;
      currentType = type;
      const cfg = tabConfig[type];
      const run = (el, update) => animate ? swapContent(el, update, dir) : update();

      document.querySelectorAll(".tab-btn").forEach(b => {
        const isActive = b.dataset.type === type;
        b.classList.toggle("active", isActive);
        b.setAttribute("aria-selected", isActive);
      });
      document.body.classList.toggle("is-empresa", type === "empresa");

      run(getEl("card-title"),    () => { getEl("card-title").textContent    = cfg.title; });
      run(getEl("card-subtitle"), () => { getEl("card-subtitle").textContent = cfg.subtitle; });
      run(getEl("btn"),           () => { getEl("btn").textContent           = cfg.btnText; });
      run(getEl("card-footer"),   () => { getEl("card-footer").innerHTML     = cfg.footer; });

      if (animate) toggleGithub(type !== "empresa");
      else getEl("github-block").hidden = type === "empresa";

      hideAlert();
    }

    // ── Helpers ────────────────────────────────────────────────
    function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }

    function setErr(inputId, errId, show) {
      const el = getEl(inputId), err = getEl(errId);
      if (!el || !err) return;
      el.classList.toggle("invalid", show);
      err.classList.toggle("visible", show);
      el.setAttribute("aria-invalid", show);
    }

    function showAlert(msg, type = "error") {
      const el = getEl("alert");
      el.textContent = msg;
      el.className = `alert ${type} visible`;
    }

    function hideAlert() {
      const el = getEl("alert");
      el.textContent = "";
      el.className = "alert";
    }

    function togglePass(id, btn) {
      const el     = getEl(id);
      const hidden = el.type === "password";
      el.type = hidden ? "text" : "password";
      getEl("icon-eye").style.display     = hidden ? "none" : "";
      getEl("icon-eye-off").style.display = hidden ? ""     : "none";
      btn.setAttribute("aria-label", hidden ? "Ocultar senha" : "Mostrar senha");
    }

    // ── Tabs: listeners ───────────────────────────────────────
    document.querySelectorAll(".tab-btn").forEach(btn => {
      btn.addEventListener("click", () => switchTab(btn.dataset.type));
    });

    // ── Validação blur ─────────────────────────────────────────
    getEl("email").addEventListener("blur", () =>
      setErr("email", "email-err", !validEmail(getEl("email").value))
    );
    getEl("password").addEventListener("blur", () =>
      setErr("password", "pass-err", getEl("password").value.trim() === "")
    );

    const errMap = { email: "email-err", password: "pass-err" };
    ["email", "password"].forEach(id => {
      getEl(id).addEventListener("input", () => {
        getEl(id).classList.remove("invalid");
        const errEl = getEl(errMap[id]);
        if (errEl) errEl.classList.remove("visible");
        hideAlert();
      });
    });

    // ── Submit ─────────────────────────────────────────────────
    getEl("form").addEventListener("submit", async e => {
      e.preventDefault();
      hideAlert();
      const email = getEl("email").value.trim();
      const pass  = getEl("password").value;
      let hasErr  = false;
      if (!validEmail(email)) { setErr("email",    "email-err", true); hasErr = true; }
      if (pass.trim() === "") { setErr("password", "pass-err",  true); hasErr = true; }
      if (hasErr) return;

      const btn = getEl("btn");
      btn.disabled    = true;
      btn.textContent = "Entrando...";
      try {
        const res  = await fetch("/api/auth/login", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password: pass, next: params.get("next") }),
        });
        const data = await res.json();
        if (!res.ok) { showAlert(data.error ?? "E-mail ou senha incorretos."); return; }
        window.location.href = data.redirect ?? "/dashboard";
      } catch {
        showAlert("Erro de conexão. Verifique sua internet e tente novamente.");
      } finally {
        btn.disabled    = false;
        btn.textContent = tabConfig[currentType].btnText;
      }
    });

    // ── Inicialização: lê URL params ───────────────────────────
    const params = new URLSearchParams(window.location.search);
    if (params.get("tipo") === "empresa") switchTab("empresa", false);

    // Login pelo GitHub também volta para a página pedida (?next=).
    if (params.get("next")) {
      document.querySelector("#github-block .btn-github").href =
        `/auth/github?next=${encodeURIComponent(params.get("next"))}`;
    }

    const urlErr = params.get("error");
    if (urlErr) {
      const msgs = {
        auth_failed:  "Falha na autenticação com GitHub. Tente novamente.",
        token_failed: "Não foi possível obter o token do GitHub.",
        invalid_state: "Seu login com o GitHub expirou ou foi aberto em outra aba. Clique em \"Continuar com GitHub\" de novo.",
        server_error: "Erro interno no servidor. Tente novamente.",
        email_in_use_company: "Este e-mail já está cadastrado como empresa. Entre com e-mail e senha.",
        account_suspended: "Esta conta está suspensa. Entre em contato com o suporte.",
      };
      showAlert(msgs[urlErr] ?? `Erro inesperado: ${urlErr}`);
    }
  </script>

  <script src="/js/form-validation.js"></script>
<%- include('partials/vlibras') %>
</body>
</html>
