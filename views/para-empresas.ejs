  <!-- ══════════ VERSÃO DESKTOP (1024px+, protótipo de 1440px) ══════════
       Preços, limites e nomes dos planos do config/plans.js (Free e PRO). O que
       o protótipo promete e não existe (dias de exposição, compatibilidade e
       triagem por IA) deu lugar ao que o produto faz. -->
  <div class="layout-desktop">

  <section class="pd-hero" aria-labelledby="pd-title-desktop">
    <h1 id="pd-title-desktop">
      Qual é o <em class="mark-purple">plano ideal</em> para a<br>
      sua empresa <em class="mark-green">contratar devs?</em>
    </h1>
    <p>
      Compare as nossas opções e descubra como otimizar seus processos seletivos com resumo de candidatos por inteligência artificial, avaliação por código real e gestão simplificada de vagas.
    </p>
  </section>

  <section class="pd-plans" aria-label="Planos para empresas">

    <article class="pd-plan" aria-labelledby="plan-free-name-desktop">
      <header class="pd-plan__head">
        <h2 id="plan-free-name-desktop">Empresa FREE</h2>
      </header>
      <p class="pd-plan__desc">Ferramentas essenciais, sem IA.</p>
      <p class="pd-plan__price"><strong>R$0</strong><span>/mês</span></p>
      <ul class="pd-plan__list">
        <li class="is-limitado"><%= planos.free.vagas %> vaga ativa por vez</li>
        <li class="is-limitado">Devs compatíveis com a vaga</li>
        <li class="is-limitado">Visualização dos candidatos inscritos</li>
        <li class="is-limitado">Compatibilidade pelo código real</li>
        <li class="is-off">Sem resumo de candidatos por IA</li>
      </ul>
      <a href="/cadastro?tipo=empresa" class="pd-btn pd-btn--ghost">Começar grátis</a>
    </article>

    <%# Seletor Mensal/Anual como o da Para Devs, com os preços do config/plans.js
        (rota /para-empresas): o mensal é a assinatura; o anual, um pagamento único
        do ano, mostrado pelo valor por mês. Sem JavaScript: o rádio marcado escolhe
        o preço pelo CSS. %>
    <article class="pd-plan pd-plan--pro" aria-labelledby="plan-pro-name-desktop">
      <header class="pd-plan__head">
        <h2 id="plan-pro-name-desktop">Empresa PRO</h2>
        <div class="pd-periodo" role="radiogroup" aria-label="Período de cobrança">
          <label><input type="radio" name="pd-periodo" value="mensal" checked>Mensal</label>
          <label><input type="radio" name="pd-periodo" value="anual">Anual</label>
        </div>
      </header>
      <p class="pd-plan__desc">Acesso a todas as ferramentas e IA.</p>
      <p class="pd-plan__price"><strong class="pd-preco-mensal">R$<%= planos.premium.mensal %></strong><strong class="pd-preco-anual">R$<%= planos.premium.anual %></strong><span>/mês</span></p>
      <ul class="pd-plan__list">
        <li>Quantidade de vagas ilimitadas</li>
        <li>Devs compatíveis com cada vaga</li>
        <li>Visualização dos candidatos inscritos</li>
        <li>Compatibilidade pelo código real</li>
        <li>Resumo de candidatos por IA</li>
      </ul>
      <p class="pd-plan__cobranca">R$<%= planos.premium.anualTotal %> por ano, à vista ou em até <%= planos.maxParcelas %>x</p>
      <a href="/cadastro?tipo=empresa" class="pd-btn pd-btn--primary">Fazer upgrade</a>
    </article>

  </section>

  <section class="pd-why" aria-labelledby="why-title-desktop">
    <h2 id="why-title-desktop">Por que evoluir para o Empresa PRO?</h2>
    <div class="pd-why__grid">

      <article class="pd-feature">
        <div class="pd-feature__top">
          <span class="pd-feature__tag">FIG 0.1</span>
