<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Painel da empresa — Ápice." />
  <title>Ápice — Painel da Empresa</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <link rel="stylesheet" href="/css/empresa-painel.css" />
</head>
<body>

  <%- include('partials/header-company', { currentPage: 'empresa-dashboard' }) %>

<main class="page-content" id="main-content">

  <section class="loading-screen" id="loading" role="status" aria-live="polite">
    <span class="spinner" aria-hidden="true"></span>
    <p>Carregando painel...</p>
  </section>

  <div class="empresa-dash" id="content" hidden>

    <!-- ══ Coluna principal ══ -->
    <div class="dash-main">

      <!-- Saudação -->
      <header class="dash-card dash-welcome">
        <h1 id="welcome-title">Olá!</h1>
        <p>Confira suas vagas criadas, acompanhe match com desenvolvedores e analise os seus candidatos.</p>
      </header>

      <!-- Acesso rápido -->
      <section class="dash-section" aria-labelledby="quick-title">
        <h2 id="quick-title">Acesso Rápido</h2>
        <ul class="quick-grid">
          <li>
            <a href="/empresa/vagas" class="dash-card quick-card">
              <span class="quick-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </span>
              <span class="quick-text">
                <strong>Suas Vagas</strong>
                <small id="quick-vagas">—</small>
              </span>
            </a>
          </li>
          <li>
            <a href="/empresa/mensagens" class="dash-card quick-card">
              <span class="quick-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="13" y2="13"/></svg>
              </span>
              <span class="quick-text">
                <strong>Chats Abertos</strong>
                <small id="quick-chats">—</small>
              </span>
            </a>
          </li>
          <li>
            <a href="/empresa/matchs" class="dash-card quick-card">
              <span class="quick-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </span>
              <span class="quick-text">
                <strong>Matches</strong>
                <small id="quick-matches">—</small>
              </span>
            </a>
          </li>
        </ul>
      </section>

      <!-- Vagas postadas -->
      <section class="dash-section" aria-labelledby="vagas-title">
        <h2 id="vagas-title">Vagas Postadas</h2>
        <ul class="dash-row" id="vagas-row"><!-- preenchido via JS: renderVagas() --></ul>
        <p class="dash-card dash-empty" id="vagas-empty" hidden>
          <strong>Nenhuma vaga publicada ainda</strong>
          Publique sua primeira vaga e comece a receber candidatos.
          <a href="/empresa/vagas/nova" class="btn-gerenciar">Publicar primeira vaga</a>
        </p>
      </section>

      <!-- Devs visualizados recentemente -->
      <section class="dash-section" aria-labelledby="devs-title">
        <h2 id="devs-title">Dev Visualizados Recentemente</h2>
        <ul class="dash-row" id="devs-row"><!-- preenchido via JS: renderDevs() --></ul>
        <p class="dash-card dash-empty" id="devs-empty" hidden>
          <strong>Nenhum perfil visualizado ainda</strong>
          Os perfis de desenvolvedores que você abrir aparecerão aqui.
          <a href="/empresa/desenvolvedores" class="btn-gerenciar">Ver desenvolvedores</a>
        </p>
      </section>

    </div>

    <!-- ══ Painel lateral ══ -->
    <aside class="dash-side" aria-labelledby="matches-title">
      <section class="dash-card matches-panel">
        <h2 id="matches-title">Matches Destaque</h2>
        <ol class="match-list" id="match-list"><!-- preenchido via JS: renderMatches() --></ol>
        <p class="dash-empty" id="matches-empty" hidden>
          <strong>Nenhum match ainda</strong>
          Publique vagas com skills definidas para ver os desenvolvedores mais compatíveis.
        </p>
        <a href="/empresa/matchs" class="matches-ver-todos" id="matches-ver-todos" hidden>Ver todos os matches →</a>
      </section>
    </aside>

  </div><!-- /content -->
</main>

<footer class="site-footer">
  <p>&copy; <script>document.write(new Date().getFullYear())</script> Ápice. Todos os direitos reservados.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script>
const LEVEL_LABEL = { estagio: "Estágio", junior: "Júnior", pleno: "Pleno" };
const AREA_LABEL  = { "front-end": "Front End", "back-end": "Back End", "full-stack": "Full Stack", dados: "Dados" };

const plural = (n, um, varios) => `${n} ${n === 1 ? um : varios}`;

function formatDate(raw) {
  if (!raw) return "—";
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? "—" : d.toLocaleDateString("pt-BR");
}

// ── Saudação e acesso rápido ──────────────────────────
function renderHeader(profile, stats) {
  const nome = profile?.nome_fantasia ?? profile?.razao_social ?? "Empresa";
  document.getElementById("welcome-title").textContent = `Olá, ${nome}!`;

  document.getElementById("quick-vagas").textContent    = plural(stats.vagasAtivas, "Vaga disponível", "Vagas disponíveis");
  document.getElementById("quick-chats").textContent    = plural(stats.conversasAbertas, "Conversa aberta", "Conversas abertas");
  document.getElementById("quick-matches").textContent  = plural(stats.matchesAltos, "Match de alta compatibilidade", "Matches de alta compatibilidade");
}

// ── Vagas postadas ────────────────────────────────────
function renderVagas(jobs) {
  const row   = document.getElementById("vagas-row");
  const empty = document.getElementById("vagas-empty");
  row.innerHTML = "";
  row.hidden   = !jobs.length;
  empty.hidden = jobs.length > 0;

  jobs.forEach(job => {
    const li = document.createElement("li");
    li.innerHTML = `
      <article class="dash-card vaga-card">
        <h3>${escapeHtml(job.title)}</h3>
        <span class="vaga-status ${job.active ? "vaga-status--ativa" : "vaga-status--inativa"}">${job.active ? "Ativa" : "Inativa"}</span>
        <dl class="vaga-dados">
          <div><dt>Área</dt> <dd>${escapeHtml(AREA_LABEL[job.area] ?? "Não definida")}</dd></div>
          <div><dt>Nível</dt> <dd>${escapeHtml(LEVEL_LABEL[job.level] ?? job.level)}</dd></div>
          <div><dt>Publicada em</dt> <dd>${formatDate(job.created_at)}</dd></div>
          <div><dt>Candidatos inscritos</dt> <dd>${job.total_candidaturas}</dd></div>
          <div><dt>Matches</dt> <dd>${job.total_matches}</dd></div>
        </dl>
        <a class="btn-gerenciar" href="/empresa/vagas/${job.id}/editar" aria-label="Gerenciar vaga ${escapeHtml(job.title)}">Gerenciar vaga</a>
      </article>`;
    row.appendChild(li);
  });
}

// ── Devs visualizados recentemente ────────────────────
function renderDevs(devs) {
  const row   = document.getElementById("devs-row");
  const empty = document.getElementById("devs-empty");
  row.innerHTML = "";
  row.hidden   = !devs.length;
  empty.hidden = devs.length > 0;

  devs.forEach(dev => {
    const li = document.createElement("li");
    li.innerHTML = `
      <article class="dash-card dev-card">
        <div class="dev-card-top">
          <h3>${escapeHtml(dev.name)}</h3>
          ${dev.isPro ? `<span class="dev-pro">PRO</span>` : ""}
        </div>
        <p class="dev-meta">${escapeHtml(LEVEL_LABEL[dev.level] ?? dev.level)}${dev.github ? ` · @${escapeHtml(dev.github)}` : ""}</p>
        <p class="dev-meta">Visto em ${formatDate(dev.viewed_at)}</p>
        <a class="dev-link" href="/empresa/dev/${dev.id}" aria-label="Ver perfil de ${escapeHtml(dev.name)}">Ver perfil →</a>
      </article>`;
    row.appendChild(li);
  });
}

// ── Matches Destaque ──────────────────────────────────
function faixaDoMatch(score) {
  if (score >= 70) return "alto";
  if (score >= 40) return "medio";
  return "baixo";
}

function renderMatches(matches) {
  const list  = document.getElementById("match-list");
  const empty = document.getElementById("matches-empty");
  list.innerHTML = "";
  list.hidden  = !matches.length;
  empty.hidden = matches.length > 0;
  document.getElementById("matches-ver-todos").hidden = !matches.length;

  matches.forEach(m => {
    const faixa = faixaDoMatch(m.score);
    const li = document.createElement("li");
    li.innerHTML = `
      <a class="match-item" href="/empresa/dev/${m.dev_id}" aria-label="${escapeHtml(m.dev)}, ${m.score}% de compatibilidade com ${escapeHtml(m.job)}">
        <span class="match-top">
          <strong>${escapeHtml(m.dev)}</strong>
          <span class="match-score match-score--${faixa}">${m.score}%</span>
        </span>
        <span class="match-job">${escapeHtml(m.job)}</span>
        <span class="match-bar match-bar--${faixa}" aria-hidden="true"><span style="width:${Math.min(100, Math.max(0, m.score))}%"></span></span>
      </a>`;
    list.appendChild(li);
  });
}

// ── Bootstrap ─────────────────────────────────────────
async function init() {
  try {
    const userRes = await fetch("/api/user");
    if (!userRes.ok) { window.location.href = "/login"; return; }
    const user = await userRes.json();
    if (user.type !== "empresa") { window.location.href = "/dashboard"; return; }
  } catch { window.location.href = "/login"; return; }

  try {
    const res = await fetch("/api/empresa/dashboard");
    if (!res.ok) throw new Error("Falha ao carregar dados");
    const data = await res.json();

    renderHeader(data.profile, data.stats);
    renderVagas(data.jobs ?? []);
    renderDevs(data.devsRecentes ?? []);
    renderMatches(data.matchesDestaque ?? []);

    document.getElementById("loading").hidden = true;
    document.getElementById("content").hidden = false;
  } catch (err) {
    console.error(err);
    document.getElementById("loading").innerHTML = `
      <section style="text-align:center" role="alert">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:12px" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p style="color:var(--red);margin-bottom:10px">Erro ao carregar o painel.</p>
        <a href="/" style="color:var(--blue);font-size:.9rem">← Voltar à home</a>
      </section>`;
  }
}

init();
</script>

<%- include('partials/vlibras') %>
</body>
</html>
