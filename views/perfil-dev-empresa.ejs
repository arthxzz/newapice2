<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <title>Perfil do Desenvolvedor — Ápice</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <style>
    .dev-profile-layout { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

    /* ── Hero card ── */
    .dev-hero { display:flex; align-items:center; gap:1.5rem; background:var(--surface); border:1px solid var(--border-lite); border-radius:var(--radius-lg); padding:1.75rem; margin-bottom:1.5rem; }
    .dev-hero-avatar { width:72px; height:72px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:1.75rem; font-weight:700; color:#fff; }
    .dev-hero-info { flex:1; min-width:0; }
    .dev-hero-name { font-size:1.3rem; font-weight:700; color:var(--text); margin:0 0 .25rem; }
    .dev-hero-github { display:inline-flex; align-items:center; gap:.35rem; color:var(--muted); font-size:.82rem; text-decoration:none; }
    .dev-hero-github:hover { color:var(--text); }
    .dev-hero-chips { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:.75rem; }
    .dev-hero-match { text-align:center; flex-shrink:0; }
    .dev-hero-match-val { font-family:var(--font-mono); font-size:2rem; font-weight:700; line-height:1; }
    .dev-hero-match-lbl { font-size:.72rem; color:var(--muted); margin-top:.2rem; }
    .match-high { color:var(--teal); }
    .match-mid  { color:var(--blue); }
    .match-low  { color:var(--muted); }

    /* ── Sections ── */
    .section-card { background:var(--surface); border:1px solid var(--border-lite); border-radius:var(--radius-lg); padding:1.5rem; margin-bottom:1.25rem; }
    .section-title { font-size:.78rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); margin:0 0 1.25rem; display:flex; align-items:center; gap:.5rem; }

    /* ── Skills ── */
    .skills-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:.6rem; }
    .skill-row { display:flex; flex-direction:column; gap:.3rem; }
    .skill-row-top { display:flex; justify-content:space-between; align-items:center; }
    .skill-name { font-size:.82rem; color:var(--text); font-weight:500; }
    .skill-pct  { font-family:var(--font-mono); font-size:.75rem; color:var(--muted); }
    .skill-bar  { height:3px; background:var(--border-lite); border-radius:2px; overflow:hidden; }
    .skill-fill { height:100%; background:var(--teal); border-radius:2px; transition:width .6s ease; }
    .no-data { color:var(--muted); font-size:.85rem; }

    /* ── Roadmap progress ── */
    .roadmap-list { display:flex; flex-direction:column; gap:.75rem; }
    .roadmap-row { display:flex; align-items:center; gap:.75rem; }
    .roadmap-job { flex:1; font-size:.83rem; color:var(--text); }
    .roadmap-bar-wrap { flex:2; height:6px; background:var(--border-lite); border-radius:3px; overflow:hidden; }
    .roadmap-bar-fill { height:100%; background:var(--teal); border-radius:3px; transition:width .6s ease; }
    .roadmap-pct { font-family:var(--font-mono); font-size:.75rem; color:var(--muted); min-width:34px; text-align:right; }

    /* ── Back button ── */
    .back-btn { display:inline-flex; align-items:center; gap:.4rem; color:var(--muted); font-size:.82rem; text-decoration:none; margin-bottom:1.5rem; }
    .back-btn:hover { color:var(--text); }

    /* ── Loading / error ── */
    .state-loading { display:flex; align-items:center; justify-content:center; min-height:60vh; flex-direction:column; gap:1rem; color:var(--muted); }
    .state-error   { text-align:center; padding:4rem 2rem; color:var(--muted); }
  </style>
</head>
<body>

  <%- include('partials/header-company', { currentPage: 'empresa-devs' }) %>

  <main class="page-content" id="main-content">

      <div id="state-loading" class="state-loading" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        <p>Carregando perfil...</p>
      </div>

      <div id="state-error" class="state-error" hidden>
        <p style="font-size:2.5rem;margin-bottom:.5rem" aria-hidden="true">⚠</p>
        <p id="error-msg">Erro ao carregar perfil.</p>
        <a href="/empresa/desenvolvedores" class="btn-ghost" style="margin-top:1rem">Voltar à lista</a>
      </div>

      <div id="state-content" class="dev-profile-layout" hidden>

        <a href="/empresa/desenvolvedores" class="back-btn" aria-label="Voltar para lista de desenvolvedores">
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Voltar
        </a>

        <!-- ══ Hero ══ -->
        <section class="dev-hero" aria-label="Resumo do desenvolvedor">
          <div class="dev-hero-avatar" id="hero-avatar" aria-hidden="true"></div>
          <div class="dev-hero-info">
            <h1 class="dev-hero-name" id="hero-name">—</h1>
            <a class="dev-hero-github" id="hero-github" href="#" target="_blank" rel="noopener noreferrer">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              —
            </a>
            <div class="dev-hero-chips" id="hero-chips"></div>
          </div>
          <div class="dev-hero-match" aria-label="Compatibilidade com suas vagas">
            <div class="dev-hero-match-val" id="hero-match">—%</div>
            <div class="dev-hero-match-lbl">compatibilidade</div>
          </div>
        </section>

        <!-- ══ Skills ══ -->
        <section class="section-card" aria-labelledby="title-skills">
          <h2 class="section-title" id="title-skills">
            <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><polygon points="9 2 2 7 9 12 16 7 9 2" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><polyline points="2 12 9 17 16 12" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
            Skills detectadas
          </h2>
          <div class="skills-grid" id="skills-grid"></div>
        </section>

        <!-- ══ Roadmap Progress ══ -->
        <section class="section-card" id="section-roadmap" aria-labelledby="title-roadmap" hidden>
          <h2 class="section-title" id="title-roadmap">
            <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Progresso em roadmaps
          </h2>
          <div class="roadmap-list" id="roadmap-list"></div>
        </section>

      </div>

    </main>

  <script>
    const LEVEL_LABEL = { estagio: "Estágio", junior: "Júnior", pleno: "Pleno" };
    const LEVEL_CLASS = { estagio: "badge-green", junior: "badge-blue", pleno: "badge-yellow" };
    const AVATAR_COLORS = [
      "linear-gradient(135deg,#7c3aed,#10b691)",
      "linear-gradient(135deg,#10b691,#60a5fa)",
      "linear-gradient(135deg,#f59e0b,#ef4444)",
      "linear-gradient(135deg,#ec4899,#7c3aed)",
      "linear-gradient(135deg,#06b6d4,#10b691)",
      "linear-gradient(135deg,#84cc16,#10b691)",
    ];

    function initials(name) {
      return (name || "?").split(" ").slice(0, 2).map(w => w[0]).join("").toUpperCase();
    }

    function matchClass(score) {
      if (score >= 80) return "match-high";
      if (score >= 60) return "match-mid";
      return "match-low";
    }

    async function init() {
      const devId = <%= devId %>;
      try {
        const uRes = await fetch("/api/user");
        if (!uRes.ok) { window.location.href = "/login"; return; }
        const user = await uRes.json();
        if (user.type !== "empresa") { window.location.href = "/dashboard"; return; }

        const dRes = await fetch(`/api/empresa/dev/${devId}`);
        if (!dRes.ok) {
          const body = await dRes.json().catch(() => ({}));
          throw new Error(body.error || "Desenvolvedor não encontrado.");
        }
        const dev = await dRes.json();

        render(dev);
      } catch (e) {
        document.getElementById("error-msg").textContent = e.message || "Erro ao carregar perfil.";
        document.getElementById("state-loading").hidden = true;
        document.getElementById("state-error").hidden   = false;
      }
    }

    function render(dev) {
      const avatarColor = AVATAR_COLORS[Math.abs(dev.id ?? 0) % AVATAR_COLORS.length];
      const avatarEl = document.getElementById("hero-avatar");
      avatarEl.style.background = avatarColor;
      avatarEl.textContent = initials(dev.name);

      document.getElementById("hero-name").textContent = dev.name || "—";

      const ghEl = document.getElementById("hero-github");
      if (dev.github) {
        ghEl.href        = `https://github.com/${dev.github}`;
        ghEl.textContent = `@${dev.github}`;
        ghEl.setAttribute("aria-label", `GitHub de ${dev.name}`);
      } else {
        ghEl.textContent = "GitHub não vinculado";
      }

      const chips = document.getElementById("hero-chips");
      chips.innerHTML = `<span class="badge ${LEVEL_CLASS[dev.level] ?? ''}">${LEVEL_LABEL[dev.level] ?? dev.level}</span>`;
      if (dev.isPro) chips.innerHTML += `<span class="badge badge-yellow" title="Perfil em destaque (plano PRO)">★ PRO</span>`;
      if (dev.best_job) chips.innerHTML += `<span class="badge badge-purple">Melhor fit: ${dev.best_job}</span>`;

      const matchEl = document.getElementById("hero-match");
      matchEl.textContent = `${dev.match}%`;
      matchEl.className   = `dev-hero-match-val ${matchClass(dev.match)}`;

      renderSkills(dev.skills ?? []);
      renderRoadmaps(dev.roadmaps ?? []);

      document.getElementById("state-loading").hidden  = true;
      document.getElementById("state-content").hidden  = false;
    }

    function renderSkills(skills) {
      const grid = document.getElementById("skills-grid");
      if (!skills.length) {
        grid.innerHTML = '<p class="no-data">Nenhuma skill detectada ainda.</p>';
        return;
      }
      grid.innerHTML = skills.slice(0, 24).map(s => `
        <div class="skill-row">
          <div class="skill-row-top">
            <span class="skill-name">${s.name}</span>
            <span class="skill-pct">${s.confidence}%</span>
          </div>
          <div class="skill-bar" role="progressbar" aria-valuenow="${s.confidence}" aria-valuemin="0" aria-valuemax="100" aria-label="${s.name}">
            <div class="skill-fill" style="width:0%" data-w="${s.confidence}%"></div>
          </div>
        </div>
      `).join("");

      requestAnimationFrame(() => requestAnimationFrame(() => {
        grid.querySelectorAll(".skill-fill[data-w]").forEach(el => {
          el.style.width = el.dataset.w;
        });
      }));
    }

    function renderRoadmaps(roadmaps) {
      if (!roadmaps.length) return;
      const section = document.getElementById("section-roadmap");
      const list    = document.getElementById("roadmap-list");
      section.hidden = false;
      list.innerHTML = roadmaps.map(r => `
        <div class="roadmap-row">
          <span class="roadmap-job">${r.job_title || `Vaga #${r.job_id}`}</span>
          <div class="roadmap-bar-wrap" role="progressbar" aria-valuenow="${r.progress}" aria-valuemin="0" aria-valuemax="100" aria-label="${r.job_title || `Vaga #${r.job_id}`}">
            <div class="roadmap-bar-fill" style="width:0%" data-w="${r.progress}%"></div>
          </div>
          <span class="roadmap-pct">${r.progress}%</span>
        </div>
      `).join("");

      requestAnimationFrame(() => requestAnimationFrame(() => {
        list.querySelectorAll(".roadmap-bar-fill[data-w]").forEach(el => {
          el.style.width = el.dataset.w;
        });
      }));
    }

    init();
  </script>

</body>
</html>
