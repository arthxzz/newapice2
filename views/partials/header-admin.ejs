<%#
  header-admin.ejs — Navbar superior da área do administrador
  Requer locals: user, currentPage
  CSS: /css/header.css
  currentPage: 'admin-dashboard' | 'admin-usuarios' | 'admin-empresas' | 'admin-vagas' | 'admin-matchs' | 'admin-relatorios' | 'admin-configuracoes'
%>

<a class="skip-link" href="#main-content">Ir para o conteúdo</a>

<header class="site-header site-header--company" id="site-header" role="banner">

  <%# ── Logo + selo de admin ─────────────────── %>
  <a href="/admin/dashboard" class="site-logo" aria-label="Ápice — painel do administrador">
    <img src="/images/principal.webp" alt="Ápice" class="nav-logo__img"
         width="90" height="22" loading="eager" />
    <span class="site-logo__divider" aria-hidden="true">/</span>
    <span class="site-logo__company">Admin</span>
  </a>

  <%# ── Nav Desktop ────────────────────────────── %>
  <nav class="header-nav" aria-label="Navegação do administrador">

    <a href="/admin/dashboard"
       class="header-link<% if (locals.currentPage === 'admin-dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-dashboard') { %>aria-current="page"<% } %>>
      Dashboard
    </a>

    <a href="/admin/usuarios"
       class="header-link<% if (locals.currentPage === 'admin-usuarios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-usuarios') { %>aria-current="page"<% } %>>
      Usuários
    </a>

    <a href="/admin/empresas"
       class="header-link<% if (locals.currentPage === 'admin-empresas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-empresas') { %>aria-current="page"<% } %>>
      Empresas
    </a>

    <a href="/admin/vagas"
       class="header-link<% if (locals.currentPage === 'admin-vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-vagas') { %>aria-current="page"<% } %>>
      Vagas
    </a>

    <a href="/admin/matchs"
       class="header-link<% if (locals.currentPage === 'admin-matchs') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-matchs') { %>aria-current="page"<% } %>>
      Matchs
    </a>

    <a href="/admin/relatorios"
       class="header-link<% if (locals.currentPage === 'admin-relatorios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-relatorios') { %>aria-current="page"<% } %>>
      Relatórios
    </a>

    <a href="/admin/configuracoes"
       class="header-link<% if (locals.currentPage === 'admin-configuracoes') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-configuracoes') { %>aria-current="page"<% } %>>
      Configurações
    </a>

  </nav>

  <%# ── Direita: user menu + hamburger ───────── %>
  <div class="header-right">

    <% if (locals.user) { %>
    <div class="header-user">
      <div class="user-menu">
        <button class="user-menu-btn" id="userMenuBtn" type="button"
                aria-haspopup="true" aria-expanded="false"
                aria-controls="userMenuList" aria-label="Menu do administrador">
          <span class="header-avatar-placeholder header-avatar-placeholder--company" aria-hidden="true">
            <%= (user.name || 'A').charAt(0).toUpperCase() %>
          </span>
          <span class="header-username"><%= (user.name || 'Admin').split(' ')[0] %></span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <ul class="user-menu-list user-menu-list--company" id="userMenuList" role="menu" hidden>
          <li role="none">
            <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="dark-mode"
                    aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
          </li>
          <li role="none">
            <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="high-contrast"
                    aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
          </li>
          <li role="separator" class="menu-divider" aria-hidden="true"></li>
          <li role="none">
            <a role="menuitem" href="/auth/logout" class="menu-item--danger">Sair</a>
          </li>
        </ul>
      </div>
    </div>
    <% } %>

    <%# ── Botão hamburger (aparece só no mobile) %>
    <button class="hamburger-btn" id="hamburgerBtn" type="button"
            aria-label="Abrir menu de navegação" aria-expanded="false"
            aria-controls="mobileDrawer">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

  </div>

</header>

<%# ═══ Mobile Drawer (admin — teal) ═══════════ %>
<div class="mobile-drawer mobile-drawer--company" id="mobileDrawer"
     role="dialog" aria-modal="true" aria-label="Menu de navegação" aria-hidden="true">

  <div class="drawer-head">
    <a href="/admin/dashboard" class="site-logo" tabindex="-1" aria-hidden="true">
      <img src="/images/principal.webp" alt="Ápice" height="22" width="90" loading="eager" />
    </a>
    <button class="drawer-close-btn" id="drawerClose" type="button" aria-label="Fechar menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navegação do administrador">

    <a href="/admin/dashboard"
       class="drawer-link<% if (locals.currentPage === 'admin-dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-dashboard') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      Dashboard
    </a>

    <a href="/admin/usuarios"
       class="drawer-link<% if (locals.currentPage === 'admin-usuarios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-usuarios') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      Usuários
    </a>

    <a href="/admin/empresas"
       class="drawer-link<% if (locals.currentPage === 'admin-empresas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-empresas') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="7" width="18" height="14" rx="2"/>
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
      </svg>
      Empresas
    </a>

    <a href="/admin/vagas"
       class="drawer-link<% if (locals.currentPage === 'admin-vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-vagas') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="7" width="20" height="14" rx="2"/>
        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
      </svg>
      Vagas
    </a>

    <a href="/admin/matchs"
       class="drawer-link<% if (locals.currentPage === 'admin-matchs') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-matchs') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      Matchs
    </a>

    <a href="/admin/relatorios"
       class="drawer-link<% if (locals.currentPage === 'admin-relatorios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-relatorios') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="20" x2="18" y2="10"/>
        <line x1="12" y1="20" x2="12" y2="4"/>
        <line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
      Relatórios
    </a>

    <a href="/admin/configuracoes"
       class="drawer-link<% if (locals.currentPage === 'admin-configuracoes') { %> is-active<% } %>"
       <% if (locals.currentPage === 'admin-configuracoes') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      Configurações
    </a>

  </nav>

  <% if (locals.user) { %>
  <div class="drawer-foot">
    <div class="drawer-user">
      <span class="drawer-avatar-ph drawer-avatar-ph--company">
        <%= (user.name || 'A').charAt(0).toUpperCase() %>
      </span>
      <div class="drawer-user-info">
        <span class="drawer-user-name"><%= user.name || user.email %></span>
        <span class="drawer-user-role">Administrador</span>
      </div>
    </div>
    <div class="drawer-foot-links">
      <button type="button" class="drawer-foot-link" data-a11y="dark-mode"
              aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
      <button type="button" class="drawer-foot-link" data-a11y="high-contrast"
              aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
      <a href="/auth/logout" class="drawer-foot-link drawer-foot-link--danger">Sair da conta</a>
    </div>
  </div>
  <% } %>

</div>

<%# ═══ Overlay ═══════════════════════════════ %>
<div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>

<%# ═══ Bottom Nav Mobile (pill — admin) ════════ %>
<nav class="bottom-nav bottom-nav--company" aria-label="Navegação do administrador">

  <a href="/admin/dashboard"
     class="bottom-nav-item<% if (locals.currentPage === 'admin-dashboard') { %> is-active<% } %>"
     <% if (locals.currentPage === 'admin-dashboard') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="14" width="7" height="7" rx="1.5"/>
      <rect x="3" y="14" width="7" height="7" rx="1.5"/>
    </svg>
    <span>Home</span>
  </a>

  <a href="/admin/usuarios"
     class="bottom-nav-item<% if (locals.currentPage === 'admin-usuarios') { %> is-active<% } %>"
     <% if (locals.currentPage === 'admin-usuarios') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
    <span>Usuários</span>
  </a>

  <a href="/admin/empresas"
     class="bottom-nav-item<% if (locals.currentPage === 'admin-empresas') { %> is-active<% } %>"
     <% if (locals.currentPage === 'admin-empresas') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="7" width="18" height="14" rx="2"/>
      <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
    </svg>
    <span>Empresas</span>
  </a>

  <a href="/admin/vagas"
     class="bottom-nav-item<% if (locals.currentPage === 'admin-vagas') { %> is-active<% } %>"
     <% if (locals.currentPage === 'admin-vagas') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="7" width="20" height="14" rx="2"/>
      <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
    </svg>
    <span>Vagas</span>
  </a>

  <a href="/admin/relatorios"
     class="bottom-nav-item<% if (locals.currentPage === 'admin-relatorios') { %> is-active<% } %>"
     <% if (locals.currentPage === 'admin-relatorios') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="20" x2="18" y2="10"/>
      <line x1="12" y1="20" x2="12" y2="4"/>
      <line x1="6" y1="20" x2="6" y2="14"/>
    </svg>
    <span>Relatórios</span>
  </a>

</nav>

<script>
(function () {
  // ── Dropdown do usuário ──────────────────────
  const menuBtn  = document.getElementById('userMenuBtn');
  const menuList = document.getElementById('userMenuList');

  function closeMenu() {
    if (!menuBtn || !menuList) return;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuList.hidden = true;
  }
  function openMenu() {
    menuBtn.setAttribute('aria-expanded', 'true');
    menuList.hidden = false;
    menuList.querySelector('[role="menuitem"]')?.focus();
  }

  if (menuBtn && menuList) {
    menuBtn.addEventListener('click', () =>
      menuBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
    );
    document.addEventListener('click', e => {
      if (!menuBtn.contains(e.target) && !menuList.contains(e.target)) closeMenu();
    });
  }

  // ── Mobile drawer ────────────────────────────
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const drawer       = document.getElementById('mobileDrawer');
  const overlay      = document.getElementById('drawerOverlay');
  const closeBtn     = document.getElementById('drawerClose');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    hamburgerBtn.classList.add('is-active');
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    hamburgerBtn?.classList.remove('is-active');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', () =>
    hamburgerBtn.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer()
  );
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeMenu(); closeDrawer(); }
  });
})();
</script>
<script src="/js/accessibility.js" defer></script>
