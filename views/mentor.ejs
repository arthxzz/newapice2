<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Converse com o mentor de carreira da Ápice." />
  <title>Ápice — Mentor de carreira</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/mensagens.css" />
  <link rel="stylesheet" href="/css/mentor-desktop.css" />
</head>
<body>

  <%- include('partials/header-dev', { currentPage: 'mentor' }) %>

<main class="page-content msg-page mentor-page" id="main-content">
  <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Mentor de carreira</h1>
  <div class="msg-layout mentor-layout" style="grid-template-columns: 1fr">

    <!-- ══ Barra lateral (só no desktop — mentor-desktop.css) ══ -->
    <aside class="mentor-sidebar" aria-label="Conversas com o mentor">
      <header class="mentor-sidebar-head">
        <span class="mentor-sidebar-icone" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.2 6.4h1.6V5.6a3.2 3.2 0 0 1 3.2-3.2h1.4a3.2 3.2 0 0 1 3.2 3.2v4.2a2.4 2.4 0 0 1-1.6 2.3l-1.4.5"/><path d="M3.6 12.6 7.6 8.6"/><circle cx="7.9" cy="8.3" r=".5" fill="currentColor"/></svg>
        </span>
        <h2 class="mentor-sidebar-titulo">Mentor</h2>
      </header>
      <label class="mentor-busca">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><line x1="20" y1="20" x2="15.3" y2="15.3"/></svg>
        <input type="search" id="mentorBusca" placeholder="Pesquisar conversas" aria-label="Pesquisar conversas" autocomplete="off" />
      </label>
      <button type="button" class="mentor-nova" id="btn-mentor-nova">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.2 3.6a1.6 1.6 0 0 1 2.3 0l.9.9a1.6 1.6 0 0 1 0 2.3L9.6 17.6 6 18.6l1-3.6z"/><path d="M8.6 4.4C5.4 5.2 3.4 7 4.6 9.2c.9 1.6-.4 3.4-1.4 5.4-.7 1.5.2 3.6 1.6 4"/></svg>
        <span>Nova conversa</span>
      </button>
      <h3 class="mentor-historico-titulo">Histórico de conversas</h3>
      <ul class="mentor-historico" id="mentorHistorico"></ul>
      <p class="mentor-historico-vazio" id="mentorHistoricoVazio" hidden></p>
    </aside>

    <!-- ══ Estado: carregando ══ -->
    <section class="msg-thread" aria-label="Mentor de carreira" id="mentorLoading">
      <p class="msg-conv-loading" style="padding:40px;text-align:center">Carregando...</p>
    </section>

    <!-- ══ Estado: gate PRO ══ -->
    <section class="msg-thread" aria-label="Mentor de carreira" id="mentorLocked" hidden>
      <div class="msg-thread-empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <p>O mentor de carreira é exclusivo do plano <strong>PRO</strong>.</p>
        <a href="/planos" class="btn-primary-dev" style="margin-top:16px">Fazer upgrade</a>
      </div>
    </section>

    <!-- ══ Estado: erro (falha de rede/servidor, não gate de plano) ══ -->
    <section class="msg-thread" aria-label="Mentor de carreira" id="mentorError" hidden>
      <div class="msg-thread-empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p>Não foi possível carregar o mentor agora. Tente novamente em instantes.</p>
        <button type="button" class="btn-primary-dev" id="btn-mentor-retry" style="margin-top:16px">Tentar de novo</button>
      </div>
    </section>

    <!-- ══ Conversa com o mentor ══ -->
    <section class="msg-thread" aria-label="Mentor de carreira" id="mentorChat" hidden>
      <header class="msg-thread-header">
        <span class="msg-thread-header-clickable" style="cursor:default">
          <span class="msg-conv-avatar" aria-hidden="true">🧭</span>
          <span class="msg-thread-header-info">
            <strong>Mentor de carreira</strong>
            <span>Tire dúvidas sobre sua evolução na área de tecnologia</span>
          </span>
        </span>
      </header>

      <div class="msg-thread-body" id="mentorBody" aria-live="polite"></div>

      <div id="mentorAnexoPreview" class="mentor-anexo-preview" hidden>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        <span id="mentorAnexoNome"></span>
        <button type="button" id="btn-mentor-anexo-remover" aria-label="Remover anexo">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form class="msg-thread-input" id="mentorForm">
        <input type="file" id="mentorAnexoInput" accept=".pdf,.txt,.md,application/pdf,text/plain,text/markdown" hidden />
        <button type="button" id="btn-mentor-anexo" class="mentor-anexo-btn" aria-label="Anexar arquivo" title="Anexar PDF, .txt ou .md">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <textarea id="mentorInput" aria-label="Mensagem para o mentor" placeholder="Pergunte algo sobre sua carreira... (Enter envia, Shift+Enter quebra linha)" rows="1" maxlength="2000" required></textarea>
        <button type="submit" id="mentorSendBtn" aria-label="Enviar mensagem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>
    </section>

  </div>
</main>

<output class="toast" id="toast" role="status" aria-live="polite"></output>

<footer class="site-footer">
  <p>&copy; <script>document.write(new Date().getFullYear())</script> Ápice. Todos os direitos reservados.</p>
</footer>

<script src="/js/ia-fetch.js"></script>
<script>
  const $ = id => document.getElementById(id);

  let toastTimer = null;
  function showToast(msg, isErr = false) {
    const el = $("toast");
    el.textContent = msg;
    el.style.borderColor = isErr ? "rgba(248,81,73,.35)" : "var(--border-lite)";
    el.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  // Desktop (a partir de 1024px): layout do protótipo — barra lateral,
  // estado vazio "Por onde começamos?" e campo "Pergunte ao Mentor"
  // (public/css/mentor-desktop.css). Celular e tablet seguem como antes.
  const DESKTOP = window.matchMedia("(min-width: 1024px)");
  const PLACEHOLDER_PADRAO = $("mentorInput").placeholder;
  let mensagensAtuais = [];
  let conversas = [];         // histórico: [{ id, titulo }], a mais recente primeiro
  let conversaAtual = null;   // id da conversa aberta; null = conversa nova

  function ajustarPlaceholder() {
    $("mentorInput").placeholder = DESKTOP.matches ? "Pergunte ao Mentor" : PLACEHOLDER_PADRAO;
  }

  // Busca sem diferenciar maiúsculas nem acentos ("tecnica" acha "técnica").
  const normalizar = texto => texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLocaleLowerCase("pt-BR");

  // Histórico da barra lateral: as conversas salvas (título = primeira
  // pergunta), a aberta em destaque. Clicar abre a conversa para continuar.
  function atualizarHistorico() {
    const busca = normalizar($("mentorBusca").value.trim());
    const visiveis = conversas.filter(c => !busca || normalizar(c.titulo).includes(busca));
    $("mentorHistorico").innerHTML = visiveis.map(c => {
      const aberta = c.id === conversaAtual;
      return `<li><button type="button" class="mentor-historico-item${aberta ? " ativo" : ""}" data-conversa="${c.id}"
        title="${escapeHtml(c.titulo).replace(/"/g, "&quot;")}"${aberta ? ' aria-current="true"' : ""}><span>${escapeHtml(c.titulo)}</span></button></li>`;
    }).join("");
    const vazio = $("mentorHistoricoVazio");
    vazio.hidden = visiveis.length > 0;
    vazio.textContent = conversas.length ? "Nenhuma conversa encontrada." : "Nenhuma conversa ainda.";
  }

  // Abre uma conversa do histórico (ou a mais recente, no celular/tablet).
  async function buscarConversa(id) {
    const res = await fetch(`/api/ai/mentor/historico?conversa=${encodeURIComponent(id)}`);
    if (!res.ok) throw new Error();
    return res.json();
  }

  function mostrarConversa({ conversa, mensagens }) {
    conversaAtual = conversa?.id ?? null;
    mensagemComFalha = null;
    renderMessages(mensagens);
  }

  // "Nova conversa": tela em branco; a conversa é criada na primeira pergunta.
  function abrirConversaNova() {
    conversaAtual = null;
    mensagemComFalha = null;
    renderMessages([]);
  }

  function renderMessages(messages) {
    mensagensAtuais = messages;
    atualizarHistorico();
    const body = $("mentorBody");
    $("mentorChat").classList.toggle("mentor-chat--vazio", !messages.length && DESKTOP.matches);
    if (!messages.length) {
      body.innerHTML = DESKTOP.matches
        ? `
        <div id="mentorEmpty" class="mentor-vazio">
          <h2 class="mentor-vazio-titulo">Por onde começamos?</h2>
          <p class="mentor-vazio-sub">Seu assistente para impulsionar sua carreira e superar seus gaps técnicos.</p>
        </div>`
        : `
        <div id="mentorEmpty">
          <p class="msg-conv-empty">Diga oi pro mentor e comece a conversa! 👋</p>
          <div style="text-align:center">
            <button type="button" class="btn-primary-dev" id="btn-mentor-entrevista">Simular uma entrevista técnica</button>
          </div>
        </div>`;
      // O atalho da entrevista só existe no modelo de celular/tablet.
      $("btn-mentor-entrevista")?.addEventListener("click", () => {
        $("mentorInput").value = "Quero simular uma entrevista técnica.";
        $("mentorForm").requestSubmit();
      });
    } else {
      body.innerHTML = messages.map(m => `
        <article class="msg-bubble-row ${m.role === "user" ? "mine" : ""}">
          <span class="msg-bubble">${escapeHtml(m.content)}</span>
          <span class="msg-bubble-time">${new Date(m.created_at).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" })}</span>
        </article>`).join("");
    }
    body.scrollTop = body.scrollHeight;
  }

  function showMentorState(state) {
    $("mentorLoading").hidden = state !== "loading";
    $("mentorLocked").hidden  = state !== "locked";
    $("mentorError").hidden   = state !== "error";
    $("mentorChat").hidden    = state !== "chat";
  }

  async function init() {
    showMentorState("loading");
    try {
      const res = await fetch("/api/ai/mentor/conversas");
      if (res.status === 402) {
        showMentorState("locked");
        return;
      }
      if (!res.ok) throw new Error();
      conversas = await res.json();
      // Desktop abre numa conversa nova ("Por onde começamos?"), com o
      // histórico ao lado; celular e tablet, sem a barra lateral, abrem a
      // conversa mais recente para continuar.
      const ultima = !DESKTOP.matches && conversas.length ? await buscarConversa(conversas[0].id) : null;
      showMentorState("chat");
      if (ultima) mostrarConversa(ultima);
      else abrirConversaNova();
    } catch {
      // Erro genérico (rede, 500, etc.) — distinto do gate de plano (402),
      // pra não dizer "exclusivo PRO" pra um usuário que já é PRO mas
      // teve uma falha transitória.
      showMentorState("error");
    }
  }

  $("btn-mentor-retry").addEventListener("click", init);

  // ── Anexo de arquivo ──────────────────────────────────
  let anexoSelecionado = null;

  function setAnexo(file) {
    anexoSelecionado = file;
    $("mentorAnexoNome").textContent = file.name;
    $("mentorAnexoPreview").hidden = false;
  }

  function clearAnexo() {
    anexoSelecionado = null;
    $("mentorAnexoInput").value = "";
    $("mentorAnexoPreview").hidden = true;
  }

  $("btn-mentor-anexo").addEventListener("click", () => $("mentorAnexoInput").click());

  $("mentorAnexoInput").addEventListener("change", () => {
    const file = $("mentorAnexoInput").files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) {
      showToast("Arquivo muito grande. Envie até 2MB.", true);
      $("mentorAnexoInput").value = "";
      return;
    }
    setAnexo(file);
  });

  $("btn-mentor-anexo-remover").addEventListener("click", clearAnexo);

  // ── Enter envia, Shift+Enter quebra linha ────────────
  $("mentorInput").addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      if (!$("mentorSendBtn").disabled) $("mentorForm").requestSubmit();
    }
  });

  // Prazo do envio: o servidor tenta o Gemini e, se ele falhar, o fallback
  // em até ~55s (services/mentorChat.js) — 60s dá folga para upload e banco.
  const MENTOR_PRAZO_MS = 60000;
  let mentorEnviando = false;
  let mensagemComFalha = null; // { mensagem, anexo } reenviada pelo "Tentar novamente"

  async function enviarAoMentor(mensagem, anexo) {
    mentorEnviando = true;
    const btn = $("mentorSendBtn");
    const input = $("mentorInput");
    btn.disabled = true;
    input.disabled = true;

    const body = $("mentorBody");
    $("mentorFalha")?.remove();
    body.insertAdjacentHTML("beforeend", `<p class="msg-conv-loading" id="mentorTyping">Mentor está digitando...</p>`);
    body.scrollTop = body.scrollHeight;

    const formData = new FormData();
    formData.append("mensagem", mensagem);
    if (conversaAtual) formData.append("conversa", conversaAtual);
    if (anexo) formData.append("anexo", anexo);

    try {
      const data = await fetchIA("/api/ai/mentor/mensagem", { method: "POST", body: formData }, MENTOR_PRAZO_MS);
      mensagemComFalha = null;

      // A pergunta pode ter começado uma conversa nova: ela vira a aberta e
      // sobe para o topo do histórico (a que já existia também sobe).
      if (data.conversa) {
        conversaAtual = data.conversa.id;
        conversas = [data.conversa, ...conversas.filter(c => c.id !== data.conversa.id)];
      }
      const historico = conversaAtual ? await buscarConversa(conversaAtual).catch(() => null) : null;
      if (historico) {
        renderMessages(historico.mensagens);
      } else {
        // O histórico não veio: mostra a resposta que já chegou.
        $("mentorTyping")?.remove();
        $("mentorPendente")?.removeAttribute("id");
        body.insertAdjacentHTML("beforeend", `
          <article class="msg-bubble-row">
            <span class="msg-bubble">${escapeHtml(data.resposta)}</span>
          </article>`);
        body.scrollTop = body.scrollHeight;
        mensagensAtuais = [...mensagensAtuais, { role: "user", content: mensagem }, { role: "assistant", content: data.resposta }];
        atualizarHistorico();
      }
    } catch (err) {
      $("mentorTyping")?.remove();
      if (err.repetivel) {
        // Rede, prazo esgotado ou IA indisponível: a pergunta fica na tela,
        // com o erro e o botão para reenviá-la.
        mensagemComFalha = { mensagem, anexo };
        body.insertAdjacentHTML("beforeend", `
          <div class="msg-conv-loading" id="mentorFalha" role="alert">
            <p>${escapeHtml(err.message)}</p>
            <button type="button" class="btn-primary-dev" id="btn-mentor-reenviar" style="margin-top:10px">Tentar novamente</button>
          </div>`);
        body.scrollTop = body.scrollHeight;
      } else {
        // Erro no pedido (arquivo inválido, plano...): devolve o texto e o
        // anexo para o usuário corrigir.
        $("mentorPendente")?.remove();
        if (!mensagensAtuais.length) renderMessages([]); // volta o estado vazio
        input.value = mensagem;
        if (anexo) setAnexo(anexo);
        showToast(err.message, true);
      }
    } finally {
      mentorEnviando = false;
      btn.disabled = false;
      input.disabled = false;
      input.focus();
    }
  }

  $("mentorBody").addEventListener("click", e => {
    if (e.target.closest("#btn-mentor-reenviar") && mensagemComFalha && !mentorEnviando) {
      enviarAoMentor(mensagemComFalha.mensagem, mensagemComFalha.anexo);
    }
  });

  $("mentorForm").addEventListener("submit", e => {
    e.preventDefault();
    if (mentorEnviando) return; // evita disparo duplicado (Enter repetido antes da resposta anterior)

    const input = $("mentorInput");
    const mensagem = input.value.trim();
    if (!mensagem) return;

    // Mensagem nova em vez de reenviar a que falhou: a anterior sai da tela
    // (o servidor já a tirou do histórico).
    mensagemComFalha = null;
    $("mentorFalha")?.remove();
    $("mentorPendente")?.remove();

    const anexo = anexoSelecionado;
    document.getElementById("mentorEmpty")?.remove();
    $("mentorChat").classList.remove("mentor-chat--vazio");
    $("mentorBody").insertAdjacentHTML("beforeend", `
      <article class="msg-bubble-row mine" id="mentorPendente">
        <span class="msg-bubble">${escapeHtml(mensagem)}${anexo ? `<br><em>📎 ${escapeHtml(anexo.name)}</em>` : ""}</span>
      </article>`);
    input.value = "";
    clearAnexo();

    enviarAoMentor(mensagem, anexo);
  });

  // ── Barra lateral (desktop) ───────────────────────────
  $("mentorBusca").addEventListener("input", atualizarHistorico);

  // Cada abertura ganha um número: se o usuário clicar em outra conversa
  // antes da anterior carregar, só a última clicada aparece.
  let aberturaAtual = 0;

  // Clique numa conversa do histórico: abre para continuar de onde parou.
  // Enquanto uma pergunta está sendo respondida, a conversa não troca.
  $("mentorHistorico").addEventListener("click", async e => {
    const item = e.target.closest("[data-conversa]");
    if (!item || mentorEnviando) return;
    const id = Number(item.dataset.conversa);
    if (id === conversaAtual) return;
    const minha = ++aberturaAtual;
    try {
      const data = await buscarConversa(id);
      if (minha !== aberturaAtual || mentorEnviando) return;
      mostrarConversa(data);
      $("mentorInput").focus();
    } catch {
      if (minha === aberturaAtual) showToast("Não foi possível abrir a conversa. Tente novamente.", true);
    }
  });

  // "Nova conversa": tela em branco; as anteriores continuam no histórico.
  $("btn-mentor-nova").addEventListener("click", () => {
    if (mentorEnviando) return;
    aberturaAtual++;
    abrirConversaNova();
    $("mentorInput").focus();
  });

  // Ao cruzar 1024px, troca o modelo do estado vazio e o placeholder.
  DESKTOP.addEventListener("change", () => {
    ajustarPlaceholder();
    if (!$("mentorChat").hidden && !mentorEnviando && !mensagensAtuais.length && document.getElementById("mentorEmpty")) {
      renderMessages([]);
    }
  });

  ajustarPlaceholder();
  init();
</script>

  <script src="/js/form-validation.js"></script>
<%- include('partials/vlibras') %>
</body>
</html>
