<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary Meta Tags -->
  <title>Ápice — Conectamos talentos. Geramos oportunidades.</title>
  <meta name="title"       content="Ápice — Conectamos talentos. Geramos oportunidades." />
  <meta name="description" content="A plataforma que analisa seu GitHub, mapeia suas skills e te conecta com vagas de estágio e emprego compatíveis com seu nível de carreira." />
  <meta name="author"      content="Ápice" />
  <meta name="robots"      content="index, follow" />
  <meta name="theme-color" content="#0a0a0f" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Ápice" />
  <meta property="og:url"         content="https://newapice22.onrender.com/" />
  <meta property="og:title"       content="Ápice — Conectamos talentos. Geramos oportunidades." />
  <meta property="og:description" content="A plataforma que analisa seu GitHub, mapeia suas skills e te conecta com vagas compatíveis com seu momento de carreira." />
  <meta property="og:locale"      content="pt_BR" />
  <meta property="og:image"       content="https://newapice22.onrender.com/images/principal.webp" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Ápice — Conectamos talentos. Geramos oportunidades." />
  <meta name="twitter:description" content="A plataforma que analisa seu GitHub e te conecta com vagas compatíveis com seu nível de carreira." />
  <meta name="twitter:image"       content="https://newapice22.onrender.com/images/principal.webp" />

  <!-- Canonical -->
  <link rel="canonical" href="https://newapice22.onrender.com/" />

  <!-- Schema.org — WebApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Ápice",
    "url": "https://newapice22.onrender.com",
    "description": "Plataforma que conecta desenvolvedores a vagas de estágio e emprego através de análise de GitHub e roadmaps personalizados de carreira.",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Any",
    "inLanguage": "pt-BR",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "BRL",
      "description": "Gratuito para desenvolvedores"
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "Desenvolvedores iniciantes e empresas de tecnologia"
    },
    "provider": {
      "@type": "Organization",
      "name": "Ápice",
      "url": "https://newapice22.onrender.com"
    }
  }
  </script>



  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/landing.css" />
</head>
<body>

  <%- include('partials/header') %>

  <main id="main-content" tabindex="-1">

    <!-- ══════════════════════════════════════════
         HERO — centralizado, com glow de fundo
    ══════════════════════════════════════════ -->
    <section class="hero" aria-labelledby="hero-title">

      <div class="bg-decor" aria-hidden="true">
        <span class="bg-decor__glow-purple"></span>
        <span class="bg-decor__top-fade"></span>
        <img class="bg-decor__topo" src="/images/imagem%20hero%20section.webp" alt="" width="697" height="683" loading="eager" />
      </div>

      <article class="hero__content">

        <h1 id="hero-title" class="hero__title">
          Descubra o quão <mark class="mark-purple">perto</mark><br>
          você está da sua próxima<br>
          vaga de <mark class="mark-teal">estágio.</mark>
        </h1>

        <p class="hero__sub">
          Conecte seu GitHub, analise suas habilidades automaticamente
          e receba um plano de estudos personalizado para conquistar a vaga que você deseja.
        </p>

        <nav class="hero__actions" aria-label="Ações principais">
          <a href="/cadastro" class="btn-primary btn-primary--purple">
            Analisar meu github
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </nav>

      </article>
    </section>

    <!-- ══════════════════════════════════════════
         LOGOS — empresas parceiras (decorativo)
    ══════════════════════════════════════════ -->
    <section class="logos logos--big" aria-label="Empresas parceiras">
      <hgroup class="section-header section-header--center container">
        <p class="section-label">Quem já está contratando</p>
        <h2 class="logos__title">Empresas Contratando</h2>
        <p class="section-desc">Times de tecnologia de todos os tamanhos já usam a Ápice pra encontrar desenvolvedores compatíveis com a vaga.</p>
      </hgroup>

      <div class="logos__viewport">
        <ul class="logos__track" aria-hidden="true">
          <!-- Conjunto 1 -->
          <li class="logos__item"><img src="/images/logo%20nubank.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20hotmart.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <li class="logos__item logos__item--picpay"><img src="/images/logo%20picpay.webp" alt="" width="100" height="100" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20ifood.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20mercado%20livre.webp" alt="" width="130" height="30" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20ci&amp;t.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <!-- Conjunto 2 (idêntico, pra loop contínuo sem emenda) -->
          <li class="logos__item"><img src="/images/logo%20nubank.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20hotmart.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <li class="logos__item logos__item--picpay"><img src="/images/logo%20picpay.webp" alt="" width="100" height="100" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20ifood.webp" alt="" width="110" height="30" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20mercado%20livre.webp" alt="" width="130" height="30" loading="lazy" /></li>
          <li class="logos__item"><img src="/images/logo%20ci&amp;t.webp" alt="" width="110" height="30" loading="lazy" /></li>
        </ul>
      </div>
    </section>

    <!-- ══════════════════════════════════════════
         UMA PLATAFORMA, DUAS EXPERIÊNCIAS
         (recompõe as seções Match + Empresas em cards lado a lado)
    ══════════════════════════════════════════ -->
    <section class="experiences" id="experiencias" aria-labelledby="experiences-title">

      <hgroup class="section-header section-header--center container">
        <p class="section-label">Como funciona para você</p>
        <h2 id="experiences-title">Uma plataforma, duas experiências</h2>
        <p class="section-desc">Desenvolvedores encontram vagas com match real. Empresas encontram devs prontos para o cargo.</p>
      </hgroup>

      <ul class="experiences__grid container">

        <!-- Card candidato -->
        <li>
        <article class="card card--dev experience-card" aria-labelledby="dev-card-title">
          <header class="head">
            <hgroup class="head__text">
              <h2 class="h2" id="dev-card-title">Desenvolvedores</h2>
              <p class="t2">Construa sua carreira com dados,<br>não com sorte.</p>
            </hgroup>
            <svg class="ico ico--code" viewBox="0 0 36 24" aria-hidden="true">
              <path d="M10 4 2 12l8 8M26 4l8 8-8 8M21 2l-6 20"/>
            </svg>
          </header>

          <h3 class="h3">Por que Ápice?</h3>

          <ul class="list">
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Saiba onde seu perfil tem maior compatibilidade.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Evolua com um plano de estudos personalizado.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Descubra suas principais habilidades automaticamente.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Candidate-se apenas às vagas certas.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Economize tempo e aumente suas chances de contratação.</span></li>
          </ul>

          <a class="lnk" href="/planos">Quer impulsionar seu currículo?<br>Conheça o Ápice Pro.</a>
        </article>
        </li>

        <!-- Card empresa -->
        <li>
        <article class="card card--emp experience-card" aria-labelledby="emp-card-title">
          <header class="head">
            <hgroup class="head__text">
              <h2 class="h2" id="emp-card-title">Empresas</h2>
              <p class="t2">Encontre talentos com mais<br>precisão.</p>
            </hgroup>
            <svg class="ico ico--case" viewBox="0 0 28 24" aria-hidden="true">
              <rect x="1.5" y="6" width="25" height="16.5" rx="3"/>
              <path d="M9.5 6V3.5a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2V6M1.5 13h25M12 11.5h4v3h-4z"/>
            </svg>
          </header>

          <h3 class="h3">Por que Ápice?</h3>

          <ul class="list">
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Publique vagas para milhares de desenvolvedores.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Receba candidatos mais alinhados ao perfil da vaga.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Analise competências técnicas em poucos segundos.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Destaque oportunidades para aumentar o alcance.</span></li>
            <li class="list__item"><svg class="arrow" viewBox="0 0 15 20" aria-hidden="true"><path d="M1 10h12.5M9 5.5l4.5 4.5L9 14.5"/></svg><span class="t1">Centralize vagas e candidatos em uma única plataforma.</span></li>
          </ul>

          <a class="lnk" href="/planos">Quer destacar suas vagas?<br>Conheça os planos disponíveis.</a>
        </article>
        </li>

      </ul>

      <nav class="experiences__actions container" aria-label="Comece agora">
        <a href="/cadastro" class="btn-primary">
          Criar conta
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/planos" class="btn-ghost">Visualizar os planos</a>
      </nav>
    </section>

    <!-- ══════════════════════════════════════════
         COMO FUNCIONA — 4 passos
    ══════════════════════════════════════════ -->
    <section class="how" id="como-funciona" aria-labelledby="how-title">

      <hgroup class="section-header section-header--center container">
        <h2 id="how-title">Entenda como funciona.</h2>
        <p class="section-desc">Da análise do seu GitHub até a conquista da sua próxima oportunidade. A Ápice reúne tudo o que você precisa para evoluir e se conectar às vagas certas em um só lugar.</p>
      </hgroup>

      <ol class="steps container">

        <li class="step-card">
          <div class="step-card__top">
            <span class="step-card__num" aria-hidden="true">FIG 0.1</span>
            <span class="step-card__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
            </span>
          </div>
          <h3 class="step-card__title"><span class="step-card__arrow" aria-hidden="true">→</span> Conecte seu GitHub</h3>
          <p class="step-card__desc">Sua jornada começa com um clique. Analisamos automaticamente seus repositórios e identificamos as principais competências.</p>
        </li>

        <li class="step-card">
          <div class="step-card__top">
            <span class="step-card__num" aria-hidden="true">FIG 0.2</span>
            <span class="step-card__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
          </div>
          <h3 class="step-card__title"><span class="step-card__arrow" aria-hidden="true">→</span> Descubra vagas ideais</h3>
          <p class="step-card__desc">Receba vagas compatíveis com seu perfil, acompanhadas por uma porcentagem de compatibilidade para candidatar-se com mais confiança.</p>
        </li>

        <li class="step-card">
          <div class="step-card__top">
            <span class="step-card__num" aria-hidden="true">FIG 0.3</span>
            <span class="step-card__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M4 19.5V22h16v-2.5M9 7h7M9 11h7"/></svg>
            </span>
          </div>
          <h3 class="step-card__title"><span class="step-card__arrow" aria-hidden="true">→</span> Receba seu Roadmap</h3>
          <p class="step-card__desc">Descubra quais conhecimentos desenvolver para alcançar as vagas que deseja, com um plano de estudos personalizado pela plataforma.</p>
        </li>

        <li class="step-card">
          <div class="step-card__top">
            <span class="step-card__num" aria-hidden="true">FIG 0.4</span>
            <span class="step-card__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>
            </span>
          </div>
          <h3 class="step-card__title"><span class="step-card__arrow" aria-hidden="true">→</span> Conquiste seu objetivo</h3>
          <p class="step-card__desc">Acompanhe sua evolução, fortaleça seu perfil e encontre oportunidades alinhadas ao seu nível técnico e aos seus objetivos profissionais.</p>
        </li>

      </ol>
    </section>

    <!-- ══════════════════════════════════════════
         RESULTADOS — dados reais (apenas se existirem)
    ══════════════════════════════════════════ -->
    <% if (stats.skills > 0 || stats.devs > 0 || stats.jobs > 0) { %>
    <section class="stats" aria-labelledby="stats-title">
      <hgroup class="section-header section-header--center container">
        <h2 id="stats-title">Resultados que conectam talentos e oportunidades.</h2>
        <p class="section-desc">Números que demonstram o impacto da <strong>Ápice</strong> na jornada de desenvolvedores e empresas.</p>
      </hgroup>
      <ul class="stats__grid container">
        <li class="stats__item">
          <p class="stats__headline">Cerca de <span class="stats__num">92%</span></p>
          <span class="stats__label">Sucesso nos matches</span>
        </li>
        <li class="stats__item">
          <p class="stats__headline">Mais de <span class="stats__num">1200</span></p>
          <span class="stats__label">Desenvolvedores cadastrados</span>
        </li>
        <li class="stats__item">
          <p class="stats__headline">Mais de <span class="stats__num">5 mil</span></p>
          <span class="stats__label">Vagas publicadas</span>
        </li>
      </ul>
    </section>
    <% } %>

    <!-- ══════════════════════════════════════════
         CTA FINAL
    ══════════════════════════════════════════ -->
    <section class="cta-final" aria-labelledby="cta-title">
      <div class="cta-final__inner container">
        <h2 id="cta-title">Pronto para começar?</h2>
        <p class="cta-final__desc">Escolha a experiência ideal e descubra como a Ápice pode conectar desenvolvedores e empresas de forma mais inteligente, rápida e eficiente.</p>
        <div class="cta-final__actions">
          <a href="/cadastro" class="cta-final__btn cta-final__btn--primary">Sou desenvolvedor</a>
          <a href="/cadastro?tipo=empresa" class="cta-final__btn cta-final__btn--ghost">Sou empresa</a>
        </div>
        <p class="cta-final__help">Possui alguma dúvida? <a href="mailto:apicetca@gmail.com">Fale conosco</a></p>
      </div>
    </section>

  </main>

  <!-- ══════════════════════════════════════════
       FOOTER
  ══════════════════════════════════════════ -->
  <footer class="site-footer" role="contentinfo">

    <section class="footer__grid container">

      <address class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Ápice — página inicial">
          <img src="/images/principal.webp" alt="Ápice" class="footer__logo-img" width="90" height="22" loading="lazy" />
        </a>
        <p class="footer__tagline">Conectamos talentos,<br>geramos oportunidades.</p>
      </address>

      <nav class="footer__nav" aria-label="Produto">
        <p class="footer__nav-title">Produto</p>
        <ul>
          <li><a href="#como-funciona">Como Funciona</a></li>
          <li><a href="/para-devs">Para Devs</a></li>
          <li><a href="/para-empresas">Para Empresas</a></li>
          <li><a href="/planos">Planos</a></li>
        </ul>
      </nav>

      <nav class="footer__nav" aria-label="Recursos">
        <p class="footer__nav-title">Recursos</p>
        <ul>
          <li><a href="/para-devs#why-title">Roadmap</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">Github</a></li>
          <li><a href="/dashboard">Dashboard</a></li>
          <li><a href="/vagas">Vagas</a></li>
        </ul>
      </nav>

      <nav class="footer__nav" aria-label="Empresa">
        <p class="footer__nav-title">Empresa</p>
        <ul>
          <li><a href="/sobre">Sobre Nós</a></li>
          <li><a href="/sobre#contato">Contato</a></li>
          <li><a href="/para-devs#faq-title">FAQ</a></li>
        </ul>
      </nav>

    </section>

    <div class="footer__bottom container">
      <small class="footer__copy">&copy; <time id="footer-year">2026</time> Ápice. Todos os direitos reservados.</small>
      <script>document.getElementById("footer-year").textContent = new Date().getFullYear();</script>
      <ul class="footer__social" aria-label="Redes sociais">
