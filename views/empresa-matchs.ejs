<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary Meta Tags -->
  <title>Matchs — Ápice</title>
  <meta name="title"       content="Matchs — Ápice" />
  <meta name="description" content="Encontre os desenvolvedores que mais combinam com as vagas da sua empresa na plataforma Ápice. Veja matches de candidaturas e orgânicos." />
  <meta name="author"      content="Ápice" />
  <meta name="robots"      content="noindex, nofollow" />
  <meta name="theme-color" content="#0a0a0f" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Ápice" />
  <meta property="og:title"       content="Matchs — Ápice" />
  <meta property="og:description" content="Desenvolvedores compatíveis com suas vagas abertas na plataforma Ápice." />
  <meta property="og:locale"      content="pt_BR" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary" />
  <meta name="twitter:title"       content="Matchs — Ápice" />
  <meta name="twitter:description" content="Desenvolvedores compatíveis com suas vagas abertas na plataforma Ápice." />

  <!-- Canonical -->
  <link rel="canonical" href="/empresa/matchs" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <link rel="stylesheet" href="/css/empresa-matchs.css" />
</head>
<body>

  <%- include('partials/header-company', { currentPage: 'empresa-matchs' }) %>

    <main class="page-content" id="main-content">

      <section class="loading-screen" id="loading" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        <p>Carregando matchs...</p>
      </section>

      <div class="mt-page" id="content" hidden>

        <!-- ══ TOPO ══ -->
        <header class="mt-top">
          <h1 class="mt-pill">Matchs</h1>
          <p>Encontre os desenvolvedores que mais combinam com suas vagas.</p>
        </header>

        <!-- ══ ESTATÍSTICAS ══ -->
        <ul class="mt-stats" aria-label="Números dos matchs">
          <li class="mt-stat"><strong id="st-total">—</strong><span>Matches totais</span></li>
          <li class="mt-stat"><strong id="st-candidaturas">—</strong><span>Matches de candidaturas</span></li>
          <li class="mt-stat"><strong id="st-organicos">—</strong><span>Matches orgânicos</span></li>
        </ul>

        <!-- ══ MATCHES (destaque) ══ -->
        <section class="mt-section" aria-labelledby="title-destaque">
          <h2 class="mt-title" id="title-destaque">
            <svg class="mt-title-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Matches
          </h2>
          <ul class="mt-grid" id="destaque-list"></ul>
          <p class="mt-vazio" id="destaque-vazio" role="status" hidden>Nenhum match ainda. Publique vagas com skills definidas para ver os desenvolvedores compatíveis.</p>
        </section>

        <!-- ══ MATCHES VAGAS ══ -->
        <section class="mt-section" aria-labelledby="title-vagas">
          <h2 class="mt-title" id="title-vagas">
            <svg class="mt-title-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
            Matches vagas
          </h2>
          <ul class="mt-vagas" id="vagas-list"></ul>
          <p class="mt-vazio" id="vagas-vazio" role="status" hidden>Você ainda não tem vagas ativas. <a href="/empresa/vagas/nova">Publicar uma vaga</a></p>
        </section>

      </div>

    </main>

  <output class="toast" id="toast" role="status" aria-live="polite"></output>

  <script src="/js/escape-html.js"></script>
  <script>
    let PAINEL = { stats: { total: 0, candidaturas: 0, organicos: 0 }, destaque: [], vagas: [] };

    const AREA_LABEL = { "front-end": "Front End", "back-end": "Back End", "full-stack": "Full Stack", dados: "Dados" };

    function formatDate(raw) {
      const d = raw ? new Date(raw) : null;
      return d && !Number.isNaN(d.getTime()) ? d.toLocaleDateString("pt-BR") : "—";
    }

    // ── Cartão de match (comVaga: no destaque mostra a vaga; nos grupos, não) ──
    function renderCard(m, comVaga) {
      const nome = escapeHtml(m.dev);
      const titulo = comVaga
        ? `<h3 class="mt-nome">${nome}</h3>`
        : `<h4 class="mt-nome">${nome}</h4>`;
      const selo = m.candidatou
        ? `<span class="mt-badge mt-badge--cand">Candidato</span>`
        : `<span class="mt-badge mt-badge--org">Orgânico</span>`;
      const vaga = comVaga
        ? `<p class="mt-vaga-box"><strong>${escapeHtml(m.job)}</strong><span>Vaga Ativa</span></p>`
        : "";
      const acoes = m.status === "aceito"
        ? `<p class="mt-aceito">Match aceito</p>`
        : `<div class="mt-acoes">
             <button type="button" class="mt-btn mt-btn--ghost" data-acao="aceitar" data-dev="${m.dev_github_id}" data-job="${m.job_id}" aria-label="Aceitar match de ${nome}">Aceitar</button>
             <button type="button" class="mt-btn mt-btn--ghost" data-acao="recusar" data-dev="${m.dev_github_id}" data-job="${m.job_id}" aria-label="Recusar match de ${nome}">Recusar</button>
           </div>`;

      return `
        <li>
          <article class="mt-card">
            <header class="mt-card-top">
              ${titulo}
              <span class="mt-tier">${m.isPro ? "PRO" : "FREE"}</span>
            </header>
            <p class="mt-handle">${m.github ? "@" + escapeHtml(m.github) : ""}</p>
            <p>${selo}</p>
            ${vaga}
            <div class="mt-compat">
              <span class="mt-pct">${m.score}%</span>
              <span class="mt-compat-label">Compatibilidade</span>
            </div>
            <div class="mt-bar" role="progressbar" aria-valuenow="${m.score}" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Compatibilidade de ${nome} com ${escapeHtml(m.job)}">
              <span style="width:${Math.min(100, Math.max(0, m.score))}%"></span>
            </div>
            <a class="mt-btn" href="/empresa/dev/${m.dev_id}" aria-label="Ver perfil de ${nome}">Ver perfil</a>
            ${acoes}
          </article>
        </li>`;
    }

    // ── Renderização ──────────────────────────────────────
    function renderStats() {
      const s = PAINEL.stats;
      document.getElementById("st-total").textContent        = s.total;
      document.getElementById("st-candidaturas").textContent = s.candidaturas;
      document.getElementById("st-organicos").textContent    = s.organicos;
    }

    function renderDestaque() {
      const list = document.getElementById("destaque-list");
      const vazio = document.getElementById("destaque-vazio");
      list.innerHTML = PAINEL.destaque.map(m => renderCard(m, true)).join("");
      list.hidden = !PAINEL.destaque.length;
      vazio.hidden = PAINEL.destaque.length > 0;
    }

    function renderVaga(v) {
      const lista = v.matches.length
        ? `<ul class="mt-row" aria-label="Devs compatíveis com ${escapeHtml(v.title)}">${v.matches.map(m => renderCard(m, false)).join("")}</ul>`
        : `<p class="mt-vazio-vaga">Nenhum desenvolvedor compatível com esta vaga ainda.</p>`;
      const mais = v.total_matches > v.matches.length
        ? `<p class="mt-mais">Mostrando os ${v.matches.length} mais compatíveis de ${v.total_matches}.</p>`
        : "";

      return `
        <li>
          <article class="mt-vaga">
            <header class="mt-vaga-head">
              <div>
                <h3>${escapeHtml(v.title)}</h3>
                <dl class="mt-vaga-dados">
                  <div><dt>Área</dt> <dd>${escapeHtml(AREA_LABEL[v.area] ?? "Não definida")}</dd></div>
                  <div><dt>Publicada em</dt> <dd>${formatDate(v.created_at)}</dd></div>
                  <div><dt>Candidatos inscritos</dt> <dd>${v.total_candidaturas}</dd></div>
                  <div><dt>Matches</dt> <dd>${v.total_matches}</dd></div>
                </dl>
              </div>
              <span class="mt-status">Ativa</span>
            </header>
            ${lista}
            ${mais}
          </article>
        </li>`;
    }

    function renderVagas() {
      const list = document.getElementById("vagas-list");
      const vazio = document.getElementById("vagas-vazio");
      list.innerHTML = PAINEL.vagas.map(renderVaga).join("");
      list.hidden = !PAINEL.vagas.length;
      vazio.hidden = PAINEL.vagas.length > 0;
    }

    function renderTudo() {
      renderStats();
      renderDestaque();
      renderVagas();
    }

    // ── Aceitar / recusar (delegação de eventos, sem onclick inline) ──
    let toastTimer = null;
    function showToast(msg, isErr = false) {
      const el = document.getElementById("toast");
      el.textContent = msg;
      el.style.borderColor = isErr ? "rgba(248,81,73,.35)" : "var(--border-lite)";
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
    }

    function aplicarAcao(devGithubId, jobId, acao) {
      const mesmo = m => m.dev_github_id === devGithubId && m.job_id === jobId;
      if (acao === "aceitar") {
        [PAINEL.destaque, ...PAINEL.vagas.map(v => v.matches)].forEach(l => l.filter(mesmo).forEach(m => { m.status = "aceito"; }));
        return;
      }
      // recusado: some das listas e das estatísticas
      const par = PAINEL.destaque.find(mesmo) ?? PAINEL.vagas.flatMap(v => v.matches).find(mesmo);
      PAINEL.destaque = PAINEL.destaque.filter(m => !mesmo(m));
      PAINEL.vagas.forEach(v => {
        const antes = v.matches.length;
        v.matches = v.matches.filter(m => !mesmo(m));
        if (v.id === jobId && (antes !== v.matches.length || par)) v.total_matches = Math.max(0, v.total_matches - 1);
      });
      PAINEL.stats.total = Math.max(0, PAINEL.stats.total - 1);
      if (par && par.candidatou) PAINEL.stats.candidaturas = Math.max(0, PAINEL.stats.candidaturas - 1);
      else PAINEL.stats.organicos = Math.max(0, PAINEL.stats.organicos - 1);
    }

    async function atualizarMatch(botao) {
      const devGithubId = Number(botao.dataset.dev);
      const jobId = Number(botao.dataset.job);
      const acao = botao.dataset.acao;
      botao.disabled = true;
      try {
        const res = await fetch(`/api/empresa/matchs/${devGithubId}/${jobId}`, {
          method:  "PATCH",
          headers: { "Content-Type": "application/json" },
          body:    JSON.stringify({ action: acao === "aceitar" ? "aceito" : "recusado" }),
        });
        if (!res.ok) throw new Error();
        aplicarAcao(devGithubId, jobId, acao);
        renderTudo();
        showToast(acao === "aceitar" ? "Match aceito!" : "Match recusado.");
      } catch {
        botao.disabled = false;
        showToast(acao === "aceitar" ? "Erro ao aceitar match." : "Erro ao recusar match.", true);
      }
    }

    document.addEventListener("click", e => {
      const botao = e.target.closest("[data-acao]");
      if (botao) atualizarMatch(botao);
    });

    // ── Início ────────────────────────────────────────────
    async function init() {
      try {
        const uRes = await fetch("/api/user");
        if (!uRes.ok) { window.location.href = "/login"; return; }
        const user = await uRes.json();
        if (user.type !== "empresa") { window.location.href = "/dashboard"; return; }

        const res = await fetch("/api/empresa/matchs/painel");
        if (!res.ok) throw new Error("Erro ao carregar matchs");
        PAINEL = await res.json();
      } catch (e) {
        showToast(e.message || "Erro ao carregar dados.", true);
      }

      renderTudo();
      document.getElementById("loading").hidden = true;
      document.getElementById("content").hidden = false;
    }

    init();
  </script>

<%- include('partials/vlibras') %>
</body>
</html>
