<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Converse com empresas — Ápice." />
  <title>Ápice — Mensagens</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/empresa-dashboard.css" />
  <link rel="stylesheet" href="/css/mensagens.css" />
  <link rel="stylesheet" href="/css/mensagens-desktop.css" />
</head>
<body>

  <%- include('partials/header-dev', { currentPage: 'mensagens' }) %>

<main class="page-content msg-page msg-page--dev" id="main-content">
  <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Mensagens</h1>
  <div class="msg-layout">

    <!-- ══ Coluna 1: lista de conversas ══ -->
    <aside class="msg-sidebar" aria-label="Suas conversas">
      <header class="msg-sidebar-head">
        <button class="msg-new-btn" id="btnNewConv" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nova conversa
        </button>
      </header>

      <div class="msg-search-row">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="convSearch" placeholder="Buscar conversas..." aria-label="Buscar conversas" />
      </div>

      <fieldset class="msg-filter-tabs" role="group" aria-label="Filtrar conversas">
        <button class="msg-filter-tab active" data-f="todas" aria-pressed="true">Todas</button>
        <button class="msg-filter-tab" data-f="nao-lidas" aria-pressed="false">
          Não lidas <span class="msg-filter-count" id="unreadTabCount" hidden>0</span>
        </button>
      </fieldset>

      <div class="msg-conv-list" id="convList" aria-live="polite">
        <p class="msg-conv-loading">Carregando conversas...</p>
      </div>
    </aside>

    <!-- ══ Coluna 2: conversa ativa ══ -->
    <section class="msg-thread" aria-label="Conversa">
      <div class="msg-thread-empty" id="threadEmpty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <p>Selecione uma conversa ou comece uma nova</p>
      </div>

      <div class="msg-thread-active" id="threadActive" hidden>
        <header class="msg-thread-header" id="threadHeader">
          <button class="msg-thread-back" id="threadBackBtn" type="button" aria-label="Voltar pra lista de conversas">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </button>
          <span class="msg-thread-header-clickable" id="threadHeaderInfo" role="button" tabindex="0" aria-label="Ver informações da empresa">
            <!-- preenchido via JS -->
          </span>
          <!-- Desktop (mensagens-desktop.css): "›" abre a empresa e "Mostrar vaga" abre a vaga da conversa -->
          <button class="msg-thread-empresa-btn" id="threadEmpresaBtn" type="button" aria-label="Ver informações da empresa">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 5 16 12 9 19"/></svg>
          </button>
          <button class="msg-thread-vaga-btn" id="threadVagaBtn" type="button" hidden>Mostrar vaga</button>
          <button class="msg-thread-details-btn" id="threadDetailsBtn" type="button">Detalhes</button>
        </header>

        <div class="msg-thread-body" id="threadBody" aria-live="polite"></div>

        <form class="msg-thread-input" id="msgForm">
          <textarea id="msgInput" aria-label="Mensagem" placeholder="Digite sua mensagem..." rows="1" maxlength="4000" required></textarea>
          <button type="submit" id="msgSendBtn" aria-label="Enviar mensagem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </form>
      </div>
    </section>

    <!-- ══ Coluna 3: painel da empresa (toggle) ══ -->
    <aside class="msg-info-panel" id="infoPanel" hidden aria-label="Sobre a empresa">
      <header class="msg-info-head"><h2 class="msg-info-titulo" id="infoPanelTitle">Empresa</h2></header>
      <button class="msg-info-close" id="infoPanelClose" type="button" aria-label="Fechar painel">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div id="infoPanelBody">
        <p class="msg-conv-loading">Carregando...</p>
      </div>
    </aside>

  </div>
</main>

<!-- ══ Modal: nova conversa (busca por vaga) ══ -->
<dialog class="modal-overlay" id="modalNewConv" role="dialog" aria-modal="true" aria-labelledby="modalNewConvTitle">
  <article class="modal">
    <header class="modal-header">
      <h2 class="modal-title" id="modalNewConvTitle">Nova conversa</h2>
      <button class="modal-close" type="button" onclick="closeNewConvModal()" aria-label="Fechar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </header>
    <p style="color:var(--muted);font-size:.82rem;margin-bottom:12px">Busque uma vaga pra conversar com a empresa responsável.</p>
    <input type="search" id="jobSearchInput" class="form-input" aria-label="Buscar vaga" placeholder="Buscar por vaga ou empresa..." autofocus />
    <div id="jobSearchResults" class="msg-job-results"></div>
  </article>
</dialog>

<output class="toast" id="toast" role="status" aria-live="polite"></output>

<footer class="site-footer">
  <p>&copy; <script>document.write(new Date().getFullYear())</script> Ápice. Todos os direitos reservados.</p>
</footer>

<script>
  const $ = id => document.getElementById(id);
  let allConversations = [];
  let activeFilter = "todas";
  let activeConversationId = null;
  let activeConversation = null;
  let allJobsCache = null;

  // Desktop (a partir de 1024px): layout do protótipo — prévia de duas linhas
  // na lista, mensagens agrupadas por remetente com a data do dia e o painel
  // "Vaga" (public/css/mensagens-desktop.css). Celular e tablet seguem como antes.
  const DESKTOP = window.matchMedia("(min-width: 1024px)");
  const BUSCA_PADRAO = $("convSearch").placeholder;
  let mensagensAtivas = [];
  let painelAtual = null; // "empresa" | "vaga" | null

  function ajustarTextos() {
    $("convSearch").placeholder = DESKTOP.matches ? "Buscar por mensagens..." : BUSCA_PADRAO;
  }

  const hora = iso => new Date(iso).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });

  // Data da lista no desktop: a hora, se for de hoje; senão dd/mm.
  function dataCurta(iso) {
    if (!iso) return "";
    const d = new Date(iso);
    return d.toDateString() === new Date().toDateString()
      ? hora(iso)
      : d.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" });
  }

  // Separador de dia na conversa ("20 de out."; com o ano, se não for o atual).
  function dataDoDia(iso) {
    const d = new Date(iso);
    const opcoes = { day: "numeric", month: "short" };
    if (d.getFullYear() !== new Date().getFullYear()) opcoes.year = "numeric";
    return d.toLocaleDateString("pt-BR", opcoes);
  }

  // "Mostrar vaga" só existe quando a conversa é sobre uma vaga, e some com o painel da vaga aberto.
  function ajustarBotaoDaVaga() {
    $("threadVagaBtn").hidden = !activeConversation?.job_id || painelAtual === "vaga";
  }

  function fecharPainel() {
    $("infoPanel").hidden = true;
    painelAtual = null;
    ajustarBotaoDaVaga();
  }

  // ── Toast ──────────────────────────────────────────────
  let toastTimer = null;
  function showToast(msg, isErr = false) {
    const el = $("toast");
    el.textContent = msg;
    el.style.borderColor = isErr ? "rgba(248,81,73,.35)" : "var(--border-lite)";
    el.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
  }

  function timeAgo(iso) {
    if (!iso) return "";
    const diff = (Date.now() - new Date(iso).getTime()) / 1000;
    if (diff < 60)    return "agora";
    if (diff < 3600)  return `${Math.floor(diff / 60)} min`;
    if (diff < 86400) return `${Math.floor(diff / 3600)} h`;
    if (diff < 604800) return `${Math.floor(diff / 86400)} d`;
    return new Date(iso).toLocaleDateString("pt-BR", { day: "2-digit", month: "short" });
  }

  function initials(name) {
    return (name || "?").trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join("").toUpperCase() || "?";
  }

  // ── Lista de conversas ───────────────────────────────────
  async function loadConversations() {
    try {
      const res = await fetch("/api/messages/conversations");
      if (!res.ok) throw new Error();
      allConversations = await res.json();
      renderConvList();
    } catch {
      $("convList").innerHTML = `<p class="msg-conv-empty">Erro ao carregar conversas.</p>`;
    }
  }

  // Item da lista no desktop: prévia inteira (o CSS corta em duas linhas),
  // data curta e, no lugar do contador, o ponto de não lida.
  function itemDesktop(c) {
    const previa = c.last_message
      ? escapeHtml(c.last_message)
      : (c.job_title ? `Sobre: ${escapeHtml(c.job_title)}` : "Nova conversa");
    return `
      <button class="msg-conv-item ${c.id === activeConversationId ? "active" : ""} ${c.unread > 0 ? "unread" : ""}" data-id="${c.id}">
        <span class="msg-conv-avatar" aria-hidden="true">${escapeHtml(initials(c.company_name))}</span>
        <span class="msg-conv-main">
          <span class="msg-conv-top">
            <strong class="msg-conv-name">${escapeHtml(c.company_name ?? "Empresa")}</strong>
            <span class="msg-conv-time">${dataCurta(c.last_message_at ?? c.created_at)}</span>
          </span>
          <span class="msg-conv-preview">${previa}</span>
        </span>
        ${c.unread > 0 ? `<span class="msg-sr">${c.unread} não lida(s)</span>` : ""}
      </button>`;
  }

  function renderConvList() {
    const q = $("convSearch").value.trim().toLowerCase();
    let list = allConversations.filter(c => {
      if (activeFilter === "nao-lidas" && !c.unread) return false;
      if (q && ![c.company_name, c.job_title, c.last_message].some(t => (t || "").toLowerCase().includes(q))) return false;
      return true;
    });

    const totalUnread = allConversations.reduce((acc, c) => acc + (c.unread > 0 ? 1 : 0), 0);
    $("unreadTabCount").hidden = totalUnread === 0;
    $("unreadTabCount").textContent = totalUnread;

    const container = $("convList");
    if (!list.length) {
      container.innerHTML = `<p class="msg-conv-empty">${allConversations.length ? "Nenhuma conversa encontrada." : "Você ainda não tem conversas. Clique em “Nova conversa” pra começar."}</p>`;
      return;
    }

    container.innerHTML = list.map(c => DESKTOP.matches ? itemDesktop(c) : `
      <button class="msg-conv-item ${c.id === activeConversationId ? "active" : ""} ${c.unread > 0 ? "unread" : ""}" data-id="${c.id}">
        <span class="msg-conv-avatar" aria-hidden="true">${escapeHtml(initials(c.company_name))}</span>
        <span class="msg-conv-main">
          <span class="msg-conv-top">
            <strong class="msg-conv-name">${escapeHtml(c.company_name ?? "Empresa")}</strong>
            <span class="msg-conv-time">${timeAgo(c.last_message_at ?? c.created_at)}</span>
          </span>
          <span class="msg-conv-bottom">
            <span class="msg-conv-preview">${c.last_message ? escapeHtml(c.last_message.slice(0, 48)) : (c.job_title ? `Sobre: ${escapeHtml(c.job_title)}` : "Nova conversa")}</span>
            ${c.unread > 0 ? `<span class="msg-conv-unread-dot" aria-label="${c.unread} não lida(s)">${c.unread}</span>` : ""}
          </span>
        </span>
      </button>`).join("");

    container.querySelectorAll(".msg-conv-item").forEach(btn => {
      btn.addEventListener("click", () => selectConversation(Number(btn.dataset.id)));
    });
  }

  $("convSearch").addEventListener("input", renderConvList);
  document.querySelectorAll(".msg-filter-tab").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".msg-filter-tab").forEach(b => { b.classList.remove("active"); b.setAttribute("aria-pressed", "false"); });
      btn.classList.add("active"); btn.setAttribute("aria-pressed", "true");
      activeFilter = btn.dataset.f;
      renderConvList();
    });
  });

  // ── Conversa ativa ────────────────────────────────────────
  async function selectConversation(id) {
    activeConversationId = id;
    activeConversation = allConversations.find(c => c.id === id) ?? null;
    renderConvList();

    $("threadEmpty").hidden = true;
    $("threadActive").hidden = false;
    $("infoPanel").hidden = true;
    painelAtual = null;
    document.querySelector(".msg-layout").classList.add("show-thread");

    renderThreadHeader();
    ajustarBotaoDaVaga();
    $("threadBody").innerHTML = `<p class="msg-conv-loading">Carregando mensagens...</p>`;

    try {
      const res = await fetch(`/api/messages/conversations/${id}`);
      if (!res.ok) throw new Error();
      const messages = await res.json();
      if (id !== activeConversationId) return;
      renderThreadMessages(messages);
      fetch(`/api/messages/conversations/${id}/read`, { method: "PATCH" }).then(() => {
        if (activeConversation) activeConversation.unread = 0;
        renderConvList();
      });
    } catch {
      $("threadBody").innerHTML = `<p class="msg-conv-empty">Erro ao carregar mensagens.</p>`;
    }
  }

  function renderThreadHeader() {
    if (!activeConversation) return;
    $("threadHeaderInfo").innerHTML = `
      <span class="msg-conv-avatar" aria-hidden="true">${escapeHtml(initials(activeConversation.company_name))}</span>
      <span class="msg-thread-header-info">
        <strong>${escapeHtml(activeConversation.company_name ?? "Empresa")}</strong>
        ${activeConversation.job_title ? `<span>${escapeHtml(activeConversation.job_title)}</span>` : ""}
      </span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-left:auto;color:var(--muted)"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
  }

  $("threadHeaderInfo").addEventListener("click", openInfoPanel);
  $("threadHeaderInfo").addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") openInfoPanel(); });
  $("threadBackBtn").addEventListener("click", () => {
    document.querySelector(".msg-layout").classList.remove("show-thread");
  });

  // Desktop: mensagens seguidas do mesmo lado (até 5 min entre elas) formam
  // um grupo com o nome e a hora em cima e, na empresa, o avatar ao lado;
  // um separador marca cada dia.
  function grupoHtml(grupo, nome) {
    const baloes = grupo.itens.map(m => `
          <article class="msg-bubble-row ${grupo.mine ? "mine" : ""}"><span class="msg-bubble">${escapeHtml(m.body)}</span></article>`).join("");
    return `
      <section class="msg-grupo ${grupo.mine ? "msg-grupo--eu" : ""}">
        ${grupo.mine ? "" : `<span class="msg-conv-avatar msg-grupo-avatar" aria-hidden="true">${escapeHtml(initials(nome))}</span>`}
        <div class="msg-grupo-corpo">
          <p class="msg-grupo-autor">${grupo.mine ? "" : `${escapeHtml(nome)} `}<time datetime="${escapeHtml(grupo.inicio)}">${hora(grupo.inicio)}</time></p>${baloes}
        </div>
      </section>`;
  }

  function mensagensDesktop(messages) {
    const nome = activeConversation?.company_name ?? "Empresa";
    let html = "";
    let dia = null;
    let grupo = null;
    const fecharGrupo = () => { if (grupo) html += grupoHtml(grupo, nome); grupo = null; };
    messages.forEach((m, i) => {
      const diaDaMensagem = new Date(m.created_at).toDateString();
      if (diaDaMensagem !== dia) {
        fecharGrupo();
        html += `<p class="msg-dia">${dataDoDia(m.created_at)}</p>`;
        dia = diaDaMensagem;
      }
      const prev = messages[i - 1];
      const junto = grupo && prev.mine === m.mine && (new Date(m.created_at) - new Date(prev.created_at)) < 5 * 60 * 1000;
      if (!junto) {
        fecharGrupo();
        grupo = { mine: m.mine, inicio: m.created_at, itens: [] };
      }
      grupo.itens.push(m);
    });
    fecharGrupo();
    return html;
  }

  function renderThreadMessages(messages) {
    mensagensAtivas = messages;
    const body = $("threadBody");
    if (!messages.length) {
      body.innerHTML = `<p class="msg-conv-empty">Nenhuma mensagem ainda. Diga oi! 👋</p>`;
    } else if (DESKTOP.matches) {
      body.innerHTML = mensagensDesktop(messages);
    } else {
      body.innerHTML = messages.map((m, i) => {
        const prev = messages[i - 1];
        const stacked = prev && prev.mine === m.mine && (new Date(m.created_at) - new Date(prev.created_at)) < 5 * 60 * 1000;
        return `
        <article class="msg-bubble-row ${m.mine ? "mine" : ""} ${stacked ? "stacked" : ""}">
          <span class="msg-bubble">${escapeHtml(m.body)}</span>
          <span class="msg-bubble-time">${new Date(m.created_at).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" })}</span>
        </article>`;
      }).join("");
    }
    body.scrollTop = body.scrollHeight;
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  // ── Composer: cresce com o texto, Enter envia (Shift+Enter quebra linha) ──
  function autoResizeInput() {
    const input = $("msgInput");
    input.style.height = "auto";
    input.style.height = Math.min(input.scrollHeight, 140) + "px";
  }
  $("msgInput").addEventListener("input", autoResizeInput);
  $("msgInput").addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      $("msgForm").requestSubmit();
    }
  });

  $("msgForm").addEventListener("submit", async e => {
    e.preventDefault();
    const input = $("msgInput");
    const body = input.value.trim();
    if (!body || !activeConversationId) return;

    const btn = $("msgSendBtn");
    btn.disabled = true;
    try {
      const res = await fetch(`/api/messages/conversations/${activeConversationId}/messages`, {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ body }),
      });
      if (!res.ok) throw new Error();
      input.value = "";
      autoResizeInput();
      const res2 = await fetch(`/api/messages/conversations/${activeConversationId}`);
      renderThreadMessages(await res2.json());
      loadConversations();
    } catch {
      showToast("Erro ao enviar mensagem.", true);
    } finally {
      btn.disabled = false;
      input.focus();
    }
  });

  // ── Painel de info da empresa ──────────────────────────────
  async function openInfoPanel() {
    if (!activeConversation) return;
    const panel = $("infoPanel");
    painelAtual = "empresa";
    $("infoPanelTitle").textContent = "Empresa";
    panel.setAttribute("aria-label", "Sobre a empresa");
    panel.hidden = false;
    ajustarBotaoDaVaga();
    $("infoPanelBody").innerHTML = `<p class="msg-conv-loading">Carregando...</p>`;

    try {
      const res = await fetch(`/api/empresas/${activeConversation.company_id}`);
      if (!res.ok) throw new Error();
      const data = await res.json();
      if (painelAtual !== "empresa") return; // trocou para a vaga enquanto carregava

      const jobsHtml = data.jobs.length
        ? data.jobs.map(j => `
            <a class="msg-info-job ${j.id === activeConversation.job_id ? "active" : ""}" href="/vagas/${j.id}" target="_blank" rel="noopener">
              <span>
                <strong>${escapeHtml(j.title)}</strong>
                <span>${({estagio:"Estágio",junior:"Júnior",pleno:"Pleno"})[j.level] ?? j.level} · ${({presencial:"Presencial",remoto:"Remoto",hibrido:"Híbrido"})[j.modality] ?? j.modality ?? ""}</span>
              </span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            </a>`).join("")
        : `<p class="msg-conv-empty">Nenhuma vaga aberta no momento.</p>`;

      $("infoPanelBody").innerHTML = `
        <span class="msg-info-avatar" aria-hidden="true">${escapeHtml(initials(data.name))}</span>
        <h3 class="msg-info-name">${escapeHtml(data.name)}</h3>
        ${data.descricao ? `<section class="msg-info-block"><h4>Sobre a empresa</h4><p>${escapeHtml(data.descricao)}</p></section>` : ""}
        <div class="msg-info-meta">
          ${data.site ? `<a href="${escapeHtml(data.site)}" target="_blank" rel="noopener"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> ${escapeHtml(data.site.replace(/^https?:\/\//, ""))}</a>` : ""}
          ${data.cidade ? `<span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> ${escapeHtml(data.cidade)}${data.estado ? ", " + escapeHtml(data.estado) : ""}</span>` : ""}
        </div>
        <section class="msg-info-block">
          <h4>Vagas em aberto (${data.jobs.length})</h4>
          <div class="msg-info-jobs">${jobsHtml}</div>
        </section>`;
    } catch {
      $("infoPanelBody").innerHTML = `<p class="msg-conv-empty">Erro ao carregar informações da empresa.</p>`;
    }
  }

  $("infoPanelClose").addEventListener("click", fecharPainel);
  $("threadDetailsBtn").addEventListener("click", openInfoPanel);
  $("threadEmpresaBtn").addEventListener("click", openInfoPanel);

  // ── Painel da vaga (desktop: "Mostrar vaga") ───────────────
  const NIVEL      = { estagio: "Estágio", junior: "Júnior", pleno: "Pleno" };
  const MODALIDADE = { presencial: "Presencial", remoto: "Remoto", hibrido: "Híbrido" };
  const INGLES     = { nenhum: "Não exigido", basico: "Básico", intermediario: "Intermediário", avancado: "Avançado", fluente: "Fluente" };
  const reais = n => new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 }).format(n);

  function faixaSalarial(job) {
    if (job.salary_min && job.salary_max) return `${reais(job.salary_min)} – ${reais(job.salary_max)}`;
    if (job.salary_min) return `a partir de ${reais(job.salary_min)}`;
    if (job.salary_max) return `até ${reais(job.salary_max)}`;
    return null;
  }

  // Etiqueta só com a cidade, como no protótipo ("São Paulo, SP" → "São Paulo");
  // o local completo continua em "Outras informações".
  const cidade = local => local.replace(/\s*[-–,/]\s*[A-Z]{2}$/, "") || local;

  function painelDaVaga(job, empresa) {
    const etiquetas = [
      job.location && cidade(job.location),
      MODALIDADE[job.modality],
      ...(job.tags ? job.tags.split(",").map(t => t.trim()).filter(Boolean) : []),
      NIVEL[job.level],
    ].filter(Boolean);
    const salario = faixaSalarial(job);
    const outras = [
      salario && `<dt>Faixa salarial</dt><dd class="msg-vaga-salario">${escapeHtml(salario)}</dd>`,
      job.english_level && job.english_level !== "nenhum" && `<dt>Inglês</dt><dd>${escapeHtml(INGLES[job.english_level] ?? job.english_level)}</dd>`,
      job.location && `<dt>Local</dt><dd>${escapeHtml(job.location)}</dd>`,
    ].filter(Boolean).join("");
    return `
      <div class="msg-vaga-topo">
        <span class="msg-vaga-empresa">
          <span class="msg-conv-avatar" aria-hidden="true">${escapeHtml(initials(empresa))}</span>
          <span>${escapeHtml(empresa)}</span>
        </span>
        <div class="msg-vaga-cabeca">
          <h3 class="msg-vaga-titulo">${escapeHtml(job.title)}</h3>
          ${job.created_at ? `<p class="msg-vaga-data">Publicação: ${new Date(job.created_at).toLocaleDateString("pt-BR")}</p>` : ""}
        </div>
      </div>
      ${etiquetas.length ? `<ul class="msg-vaga-tags" aria-label="Detalhes da vaga">${etiquetas.map(t => `<li><span>${escapeHtml(t)}</span></li>`).join("")}</ul>` : ""}
      <section class="msg-vaga-cartao">
        ${job.description ? `<h4>Descrição da vaga</h4><p class="msg-vaga-texto">${escapeHtml(job.description)}</p>` : ""}
        ${job.responsibilities ? `<h4>Responsabilidades</h4><p class="msg-vaga-texto msg-vaga-resp">${escapeHtml(job.responsibilities)}</p>` : ""}
        <a class="msg-vaga-mais" href="/vagas/${encodeURIComponent(job.id)}" target="_blank" rel="noopener">Ver mais</a>
        ${outras ? `<h4>Outras informações</h4><dl class="msg-vaga-info">${outras}</dl>` : ""}
      </section>`;
  }

  async function abrirPainelDaVaga() {
    const conversa = activeConversation;
    if (!conversa?.job_id) return;
    painelAtual = "vaga";
    $("infoPanelTitle").textContent = "Vaga";
    $("infoPanel").setAttribute("aria-label", "Vaga da conversa");
    $("infoPanel").hidden = false;
    ajustarBotaoDaVaga();
    $("infoPanelBody").innerHTML = `<p class="msg-conv-loading">Carregando...</p>`;
    try {
      const res = await fetch(`/api/vagas/${encodeURIComponent(conversa.job_id)}`);
      if (conversa !== activeConversation || painelAtual !== "vaga") return;
      if (res.status === 404) {
        $("infoPanelBody").innerHTML = `<p class="msg-conv-empty">Esta vaga não está mais disponível.</p>`;
        return;
      }
      if (!res.ok) throw new Error();
      const job = await res.json();
      if (conversa !== activeConversation || painelAtual !== "vaga") return;
      $("infoPanelBody").innerHTML = painelDaVaga(job, conversa.company_name ?? job.company ?? "Empresa");
    } catch {
      if (painelAtual === "vaga") $("infoPanelBody").innerHTML = `<p class="msg-conv-empty">Erro ao carregar a vaga.</p>`;
    }
  }

  $("threadVagaBtn").addEventListener("click", abrirPainelDaVaga);

  // Ao cruzar 1024px, troca os modelos (lista e mensagens) e os textos; o
  // painel da vaga, que só existe no desktop, fecha.
  DESKTOP.addEventListener("change", () => {
    ajustarTextos();
    renderConvList();
    if (activeConversationId && mensagensAtivas.length) renderThreadMessages(mensagensAtivas);
    if (!DESKTOP.matches && painelAtual === "vaga") fecharPainel();
  });
  ajustarTextos();

  // ── Nova conversa (busca por vaga) ─────────────────────────
  function openNewConvModal() {
    $("modalNewConv").showModal();
    $("modalNewConv").classList.add("open");
    $("jobSearchInput").value = "";
    $("jobSearchInput").focus();
    loadJobsForSearch();
  }
  function closeNewConvModal() { $("modalNewConv").close(); }

  $("btnNewConv").addEventListener("click", openNewConvModal);
  $("modalNewConv").addEventListener("close", () => $("modalNewConv").classList.remove("open"));
  $("modalNewConv").addEventListener("click", e => { if (e.target === e.currentTarget) closeNewConvModal(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeNewConvModal(); });

  async function loadJobsForSearch() {
    if (!allJobsCache) {
      try {
        const res = await fetch("/api/jobs/detalhes");
        const data = await res.json();
        allJobsCache = data.data ?? [];
      } catch {
        allJobsCache = [];
      }
    }
    renderJobSearchResults();
  }

  function renderJobSearchResults() {
    const q = $("jobSearchInput").value.trim().toLowerCase();
    const results = (allJobsCache ?? [])
      .filter(j => !q || j.title.toLowerCase().includes(q) || (j.company ?? "").toLowerCase().includes(q))
      .slice(0, 30);

    $("jobSearchResults").innerHTML = results.length
      ? results.map(j => `
          <button class="msg-job-result" data-job-id="${j.id}">
            <span>
              <strong>${escapeHtml(j.title)}</strong>
              <span>${escapeHtml(j.company ?? "Empresa")}</span>
            </span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>`).join("")
      : `<p class="msg-conv-empty">Nenhuma vaga encontrada.</p>`;

    $("jobSearchResults").querySelectorAll(".msg-job-result").forEach(btn => {
      btn.addEventListener("click", () => startConversationFromJob(Number(btn.dataset.jobId)));
    });
  }

  $("jobSearchInput").addEventListener("input", renderJobSearchResults);

  async function startConversationFromJob(jobId) {
    try {
      const res = await fetch("/api/messages/conversations", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ job_id: jobId }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? "Erro ao iniciar conversa");

      closeNewConvModal();
      await loadConversations();
      selectConversation(data.conversation_id);
    } catch (err) {
      showToast(err.message, true);
    }
  }

  loadConversations();
</script>

  <script src="/js/form-validation.js"></script>
<%- include('partials/vlibras') %>
</body>
</html>
