<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary Meta Tags -->
  <title>Desenvolvedores — Ápice</title>
  <meta name="title"       content="Desenvolvedores — Ápice" />
  <meta name="description" content="Pesquise desenvolvedores, sejam eles candidatados ou não para as vagas da sua empresa na plataforma Ápice." />
  <meta name="author"      content="Ápice" />
  <meta name="robots"      content="noindex, nofollow" />
  <meta name="theme-color" content="#0a0a0f" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Ápice" />
  <meta property="og:title"       content="Desenvolvedores — Ápice" />
  <meta property="og:description" content="Pesquise desenvolvedores, sejam eles candidatados ou não para as suas vagas." />
  <meta property="og:locale"      content="pt_BR" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary" />
  <meta name="twitter:title"       content="Desenvolvedores — Ápice" />
  <meta name="twitter:description" content="Encontre talentos compatíveis com suas vagas abertas na Ápice." />

  <!-- Canonical -->
  <link rel="canonical" href="/empresa/desenvolvedores" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <link rel="stylesheet" href="/css/empresa-desenvolvedores.css" />
</head>
<body>

  <%- include('partials/header-company', { currentPage: 'empresa-devs' }) %>

    <main class="page-content" id="main-content">

      <section class="loading-screen" id="loading" role="status" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span>
        <p>Carregando desenvolvedores...</p>
      </section>

      <div class="devs-page" id="content" hidden>

        <!-- ══ TOPO ══ -->
        <header class="devs-top">
          <h1 class="devs-pill">Desenvolvedores</h1>
          <p>Pesquise desenvolvedores, sejam eles candidatados ou não para suas vagas.</p>
        </header>

        <!-- ══ BUSCA ══ -->
        <search class="devs-search" aria-label="Busca de desenvolvedores">
          <label class="devs-search-wrap" for="dev-search">
            <span class="devs-search-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 14 14" fill="none">
                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M10.5 10.5L13 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </span>
            <input
              type="search"
              class="devs-search-input"
              id="dev-search"
              placeholder="Pesquisar por desenvolvedores"
              autocomplete="off"
              aria-label="Pesquisar por desenvolvedores (nome, skill ou GitHub)"
            />
          </label>
        </search>

        <!-- ══ ABAS ══ -->
        <div class="devs-tabs" role="tablist" aria-label="Visualização dos desenvolvedores">
          <button type="button" class="devs-tab" role="tab" id="aba-vagas" aria-selected="true" aria-controls="painel-vagas">Dev em Vagas</button>
          <button type="button" class="devs-tab" role="tab" id="aba-geral" aria-selected="false" aria-controls="painel-geral" tabindex="-1">Desenvolvedores Geral</button>
        </div>

        <!-- ══ FILTRO ══ -->
        <div class="devs-filtro">
          <button type="button" class="devs-filtro-btn" id="filtro-btn" aria-expanded="false" aria-controls="filtro-painel">
            Filtro:
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          </button>
          <fieldset class="devs-filters" id="filtro-painel" hidden>
            <legend class="sr-only">Filtrar desenvolvedores</legend>
            <button type="button" class="filter-chip active" data-f="todos"   aria-pressed="true">Todos</button>
            <button type="button" class="filter-chip" data-f="estagio"        aria-pressed="false">Estágio</button>
            <button type="button" class="filter-chip" data-f="junior"         aria-pressed="false">Júnior</button>
            <button type="button" class="filter-chip" data-f="pleno"          aria-pressed="false">Pleno</button>
            <button type="button" class="filter-chip" data-f="match"          aria-pressed="false">Alta compatibilidade</button>
          </fieldset>
        </div>

        <!-- ══ PAINEL 1: candidatos por vaga ══ -->
        <section class="devs-panel" id="painel-vagas" role="tabpanel" aria-labelledby="aba-vagas" tabindex="0">
          <h2 class="sr-only">Candidatos por vaga</h2>
          <ul class="vagas-list" id="vagas-list"><!-- preenchido via JS: renderVagas() --></ul>
        </section>

        <!-- ══ PAINEL 2: todos os desenvolvedores ══ -->
        <section class="devs-panel" id="painel-geral" role="tabpanel" aria-labelledby="aba-geral" tabindex="0" hidden>
          <h2 class="sr-only">Todos os desenvolvedores <span id="devs-count"></span></h2>
          <ul class="devs-grid" id="devs-grid" role="list"><!-- preenchido via JS: render() --></ul>
        </section>

      </div>

    </main>

  <output class="toast" id="toast" role="status" aria-live="polite"></output>

  <script src="/js/escape-html.js"></script>
  <script>
    let DEVS = [];   // aba "Desenvolvedores Geral"
    let JOBS = [];   // aba "Dev em Vagas": vagas com seus candidatos

    const LEVEL_LABEL  = { estagio:"Estágio", junior:"Júnior", pleno:"Pleno" };
    const LEVEL_CLASS  = { estagio:"badge-green", junior:"badge-blue", pleno:"badge-yellow" };
    const AREA_LABEL   = { "front-end":"Front End", "back-end":"Back End", "full-stack":"Full Stack", dados:"Dados" };
    const MATCH_LABEL  = { realizado:"Realizado", recusado:"Recusado", nao_realizado:"Não realizado" };
    const AVATAR_COLORS = [
      "linear-gradient(135deg,#04A07D,#10b691)",
      "linear-gradient(135deg,#10b691,#60a5fa)",
      "linear-gradient(135deg,#f59e0b,#ef4444)",
      "linear-gradient(135deg,#ec4899,#04A07D)",
      "linear-gradient(135deg,#06b6d4,#10b691)",
      "linear-gradient(135deg,#84cc16,#10b691)",
    ];
    const ALTA_COMPATIBILIDADE = 80;

    let activeFilter = "todos";
    let searchQuery  = "";
    let activeTab    = "vagas";

    function initials(name) {
      return (name || "?").split(" ").slice(0,2).map(w => w[0]).join("").toUpperCase();
    }

    function formatDate(raw) {
      const d = raw ? new Date(raw) : null;
      return d && !Number.isNaN(d.getTime()) ? d.toLocaleDateString("pt-BR") : "—";
    }

    function scoreClass(score) {
      if (score >= 80) return "dev-score--high";
      if (score >= 60) return "dev-score--mid";
      return "dev-score--low";
    }

    // ── Filtros (valem para as duas abas) ─────────────────
    function passaNoFiltro({ level, score, name, github, skills }) {
      const okFiltro =
        activeFilter === "todos" ? true :
        activeFilter === "match" ? score >= ALTA_COMPATIBILIDADE :
        level === activeFilter;

      const q = searchQuery.toLowerCase();
      const okBusca = !q ||
        (name   || "").toLowerCase().includes(q) ||
        (github || "").toLowerCase().includes(q) ||
        (skills || []).some(s => s.toLowerCase().includes(q));

      return okFiltro && okBusca;
    }

    const filtrando = () => activeFilter !== "todos" || searchQuery !== "";

    // ══ ABA 1: Dev em Vagas ══════════════════════════════
    function renderCandidato(c, job) {
      const chips = c.skills.map(s => `<li class="cand-chip">${escapeHtml(s)}</li>`).join("") +
        (c.skills_extra > 0 ? `<li class="cand-chip cand-chip--more">+${c.skills_extra}</li>` : "");

      return `
        <li>
          <article class="cand-card">
            <header class="cand-top">
              <h3>${escapeHtml(c.name)}</h3>
              <span class="cand-tier">${c.isPro ? "PRO" : "FREE"}</span>
            </header>
            <p class="cand-handle">${c.github ? "@" + escapeHtml(c.github) : ""}</p>
            <p><span class="cand-badge">Candidato</span></p>

            <dl class="cand-dados">
              <div><dt>Senioridade</dt> <dd>${escapeHtml(LEVEL_LABEL[c.level] ?? c.level)}</dd></div>
            </dl>

            <div class="cand-skills-box">
              <p class="cand-label">Skills:</p>
              <ul class="cand-skills" aria-label="Skills de ${escapeHtml(c.name)}">${chips || '<li class="cand-chip cand-chip--more">Sem skills</li>'}</ul>
            </div>

            <p class="cand-match">Match: <strong>${MATCH_LABEL[c.match_status] ?? MATCH_LABEL.nao_realizado}</strong></p>

            <div class="cand-compat">
              <span class="cand-pct">${c.score}%</span>
              <span class="cand-compat-label">Compatibilidade</span>
            </div>
            <div class="cand-bar" role="progressbar" aria-valuenow="${c.score}" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Compatibilidade de ${escapeHtml(c.name)} com ${escapeHtml(job.title)}">
              <span style="width:${Math.min(100, Math.max(0, c.score))}%"></span>
            </div>

            <a class="cand-btn" href="/empresa/vagas/${job.id}/candidaturas"
               aria-label="Gerenciar candidatura de ${escapeHtml(c.name)}">Gerenciar candidatura</a>
            <a class="cand-btn cand-btn--ver" href="/empresa/dev/${c.id}"
               aria-label="Ver perfil de ${escapeHtml(c.name)}">Ver perfil</a>
          </article>
        </li>`;
    }

    function renderVaga(job, candidatos) {
      const status = job.active
        ? `<span class="vaga-status vaga-status--ativa">Ativa</span>`
        : `<span class="vaga-status vaga-status--inativa">Inativa</span>`;

      const lista = candidatos.length
        ? `<ul class="cand-row" aria-label="Candidatos de ${escapeHtml(job.title)}">${candidatos.map(c => renderCandidato(c, job)).join("")}</ul>`
        : `<p class="cand-vazio">${filtrando() ? "Nenhum candidato encontrado com esse filtro." : "Nenhum candidato nesta vaga ainda."}</p>`;

      const mais = job.total_candidaturas > job.candidatos.length
        ? `<p class="cand-mais">Mostrando os ${job.candidatos.length} mais compatíveis de ${job.total_candidaturas}. <a href="/empresa/vagas/${job.id}/candidaturas">Ver todas as candidaturas</a></p>`
        : "";

      return `
        <li>
          <article class="vaga-grupo">
            <header class="vaga-grupo-head">
              <div>
                <h2>${escapeHtml(job.title)}</h2>
                <dl class="vaga-grupo-dados">
                  <div><dt>Área</dt> <dd>${escapeHtml(AREA_LABEL[job.area] ?? "Não definida")}</dd></div>
                  <div><dt>Publicada em</dt> <dd>${formatDate(job.created_at)}</dd></div>
                  <div><dt>Candidatos inscritos</dt> <dd>${job.total_candidaturas}</dd></div>
                  <div><dt>Matches</dt> <dd>${job.total_matches}</dd></div>
                </dl>
              </div>
              ${status}
            </header>
            ${lista}
            ${mais}
          </article>
        </li>`;
    }

    function renderVagas() {
      const list = document.getElementById("vagas-list");

      const grupos = JOBS
        .map(job => ({ job, candidatos: job.candidatos.filter(c => passaNoFiltro({ ...c, skills: c.skills })) }))
        // com busca/filtro ativos, só mostra vagas que tenham resultado
        .filter(g => !filtrando() || g.candidatos.length);

      if (!grupos.length) {
        list.innerHTML = `
          <li class="devs-empty">
            <p class="devs-empty-title">${JOBS.length ? "Nenhum desenvolvedor encontrado" : "Você ainda não tem vagas"}</p>
            <p class="devs-empty-sub">${JOBS.length ? "Tente ajustar os filtros ou a busca." : "Publique uma vaga para receber candidaturas."}</p>
          </li>`;
        return;
      }
      list.innerHTML = grupos.map(g => renderVaga(g.job, g.candidatos)).join("");
    }

    // ══ ABA 2: Desenvolvedores Geral ═════════════════════
    function renderCard(dev) {
      const shown = (dev.skills || []).slice(0, 3);
      const extra = (dev.skills || []).length - 3;
      const skillItems = shown.map(s => {
        const declarada = dev.skillsOrigem?.[s] === "manual";
        return `<li class="skill-tag">${escapeHtml(s)}<span class="skill-origem ${declarada ? "skill-origem--declarada" : "skill-origem--github"}">${declarada ? "declarada" : "detectada no GitHub"}</span></li>`;
      }).join("") +
        (extra > 0 ? `<li class="skill-tag skill-tag--more">+${extra}</li>` : "");

      const avatarColor = AVATAR_COLORS[Math.abs(dev.id ?? 0) % AVATAR_COLORS.length];

      return `
        <li class="dev-card" data-id="${dev.id}">
          <span class="dev-score ${scoreClass(dev.match)}" aria-label="Match de ${dev.match}%">${dev.match}% match</span>

          <header class="dev-card-top">
            <span class="dev-avatar" style="background:${avatarColor}" aria-hidden="true">${escapeHtml(initials(dev.name))}</span>
            <address class="dev-identity">
              <p class="dev-name">${escapeHtml(dev.name)}</p>
              <a class="dev-github" href="https://github.com/${encodeURIComponent(dev.github)}" target="_blank" rel="noopener noreferrer" aria-label="GitHub de ${escapeHtml(dev.name)}">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                @${escapeHtml(dev.github)}
              </a>
              <span class="badge ${LEVEL_CLASS[dev.level] ?? ""} dev-level-badge">${LEVEL_LABEL[dev.level] ?? dev.level}</span>
              ${dev.isPro ? `<span class="badge badge-yellow dev-level-badge" title="Perfil em destaque (plano PRO)">★ PRO</span>` : ""}
            </address>
          </header>

          <ul class="dev-skills" aria-label="Skills de ${escapeHtml(dev.name)}">
            ${skillItems || '<li class="skill-tag">Sem skills detectadas</li>'}
          </ul>

          <footer class="dev-stats" aria-label="Progresso de ${escapeHtml(dev.name)}">
            <p class="dev-stat-row">
              <span class="dev-stat-label">Roadmap</span>
              <span class="dev-stat-bar" role="progressbar" aria-valuenow="${dev.progress}" aria-valuemin="0" aria-valuemax="100" aria-label="Progresso do roadmap">
                <span class="dev-stat-fill dev-stat-fill--teal" style="width:0%" data-w="${dev.progress}%"></span>
              </span>
              <span class="dev-stat-pct">${dev.progress}%</span>
            </p>
            <p class="dev-stat-row">
              <span class="dev-stat-label">Match</span>
              <span class="dev-stat-bar" role="progressbar" aria-valuenow="${dev.match}" aria-valuemin="0" aria-valuemax="100" aria-label="Compatibilidade com a vaga">
                <span class="dev-stat-fill dev-stat-fill--purple" style="width:0%" data-w="${dev.match}%"></span>
              </span>
              <span class="dev-stat-pct">${dev.match}%</span>
            </p>
          </footer>

          <nav class="dev-actions" aria-label="Ações para ${escapeHtml(dev.name)}">
            <a href="/empresa/dev/${dev.id}" class="dev-btn dev-btn--primary">
              <svg width="12" height="12" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="6" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M2 16C2 13.24 5.13 11 9 11C12.87 11 16 13.24 16 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              Ver perfil
            </a>
          </nav>
        </li>`;
    }

    function render() {
      const filtered = DEVS.filter(dev => passaNoFiltro({
        level: dev.level, score: dev.match, name: dev.name, github: dev.github, skills: dev.skills,
      }));
      const grid = document.getElementById("devs-grid");

      document.getElementById("devs-count").textContent = `(${filtered.length})`;

      if (!filtered.length) {
        grid.innerHTML = `
          <li class="devs-empty">
            <span class="devs-empty-icon" aria-hidden="true">
              <svg width="38" height="38" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="6" r="3" stroke="currentColor" stroke-width="1.1"/><path d="M2 16C2 13.24 5.13 11 9 11C12.87 11 16 13.24 16 16" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
            </span>
            <p class="devs-empty-title">Nenhum desenvolvedor encontrado</p>
            <p class="devs-empty-sub">Tente ajustar os filtros ou a busca.</p>
          </li>`;
        return;
      }

      grid.innerHTML = filtered.map(renderCard).join("");

      requestAnimationFrame(() => requestAnimationFrame(() => {
        grid.querySelectorAll(".dev-stat-fill[data-w]").forEach(el => {
          el.style.width = el.dataset.w;
        });
      }));
    }

    function renderTudo() {
      renderVagas();
      render();
    }

    // ── Abas (setas, Home e End, como no padrão WAI-ARIA) ──
    const ABAS = ["vagas", "geral"];

    function selecionarAba(nome, { foco = false } = {}) {
      activeTab = nome;
      ABAS.forEach(a => {
        const aba = document.getElementById(`aba-${a}`);
        const selecionada = a === nome;
        aba.setAttribute("aria-selected", String(selecionada));
        aba.tabIndex = selecionada ? 0 : -1;
        document.getElementById(`painel-${a}`).hidden = !selecionada;
        if (selecionada && foco) aba.focus();
      });
    }

    ABAS.forEach((a, i) => {
      const aba = document.getElementById(`aba-${a}`);
      aba.addEventListener("click", () => selecionarAba(a));
      aba.addEventListener("keydown", e => {
        const destino =
          e.key === "ArrowRight" ? ABAS[(i + 1) % ABAS.length] :
          e.key === "ArrowLeft"  ? ABAS[(i - 1 + ABAS.length) % ABAS.length] :
          e.key === "Home" ? ABAS[0] :
          e.key === "End"  ? ABAS[ABAS.length - 1] : null;
        if (destino) { e.preventDefault(); selecionarAba(destino, { foco: true }); }
      });
    });

    // ── Filtro (painel que abre e fecha) ──────────────────
    const filtroBtn   = document.getElementById("filtro-btn");
    const filtroPanel = document.getElementById("filtro-painel");
    filtroBtn.addEventListener("click", () => {
      const abrir = filtroPanel.hidden;
      filtroPanel.hidden = !abrir;
      filtroBtn.setAttribute("aria-expanded", String(abrir));
    });

    document.querySelectorAll(".filter-chip").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-chip").forEach(b => {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");
        activeFilter = btn.dataset.f;
        renderTudo();
      });
    });

    document.getElementById("dev-search").addEventListener("input", e => {
      searchQuery = e.target.value.trim();
      renderTudo();
    });

    let toastTimer = null;
    function showToast(msg, isErr = false) {
      const el = document.getElementById("toast");
      el.textContent = msg;
      el.style.borderColor = isErr ? "rgba(248,81,73,.35)" : "var(--border-lite)";
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
    }

    async function carregar(url) {
      const res = await fetch(url);
      if (!res.ok) throw new Error("Erro ao carregar desenvolvedores");
      return res.json();
    }

    async function init() {
      try {
        const uRes = await fetch("/api/user");
        if (!uRes.ok) { window.location.href = "/login"; return; }
        const user = await uRes.json();
        if (user.type !== "empresa") { window.location.href = "/dashboard"; return; }
      } catch (e) {
        showToast("Erro ao carregar dados.", true);
      }

      // Uma aba pode falhar sem derrubar a outra.
      const [vagas, geral] = await Promise.allSettled([
        carregar("/api/empresa/jobs/candidatos"),
        carregar("/api/empresa/desenvolvedores"),
      ]);
      if (vagas.status === "fulfilled") JOBS = vagas.value;
      if (geral.status === "fulfilled") DEVS = geral.value;
      if (vagas.status === "rejected" || geral.status === "rejected") {
        showToast("Parte dos dados não pôde ser carregada.", true);
      }

      renderTudo();
      document.getElementById("loading").hidden = true;
      document.getElementById("content").hidden = false;
    }

    init();
  </script>

<%- include('partials/vlibras') %>
</body>
</html>
