<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Gestão de desenvolvedores — Ápice." />
  <title>Ápice — Admin · Usuários</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/empresa-dashboard.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-usuarios' }) %>

<main class="page-content" id="main-content">

  <section class="loading-screen" id="loading" role="status" aria-live="polite">
    <span class="spinner" aria-hidden="true"></span>
    <p>Carregando desenvolvedores...</p>
  </section>

  <article id="content" hidden>
    <section class="section" aria-label="Desenvolvedores cadastrados">
      <header class="section-header">
        <h1 class="section-title">Desenvolvedores <span class="section-count" id="users-count"></span></h1>
        <fieldset class="filter-row" role="group" aria-label="Filtrar por status">
          <button class="filter-chip active" data-f="todos"     aria-pressed="true">Todos</button>
          <button class="filter-chip"        data-f="ativos"    aria-pressed="false">Ativos</button>
          <button class="filter-chip"        data-f="suspensos" aria-pressed="false">Suspensos</button>
        </fieldset>
      </header>

      <figure class="jobs-table-wrap">
        <table class="jobs-table" id="users-table" aria-label="Lista de desenvolvedores">
          <thead>
            <tr>
              <th scope="col">Nome</th>
              <th scope="col">E-mail</th>
              <th scope="col">Nível</th>
              <th scope="col">GitHub</th>
              <th scope="col">Plano</th>
              <th scope="col">Cadastro</th>
              <th scope="col">Status</th>
              <th scope="col">Ações</th>
            </tr>
          </thead>
          <tbody id="users-tbody"></tbody>
        </table>
        <section class="table-empty" id="users-empty" hidden>
          <p class="table-empty-title">Nenhum desenvolvedor encontrado</p>
        </section>
      </figure>
    </section>
  </article>
</main>

<output class="toast" id="toast" role="status" aria-live="polite"></output>

<footer class="site-footer">
  <p>&copy; <script>document.write(new Date().getFullYear())</script> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script>
const NIVEL_LABEL = { iniciante: "Iniciante", intermediario: "Intermediário", avancado: "Avançado" };
const PLAN_LABEL  = { dev_free: "Gratuito", dev_pro: "PRO" };
let allUsers = [];

// A mesma pessoa pode ter uma conta do login com GitHub e outra de e-mail e
// senha; o plano vale por conta, então o admin precisa saber por qual ela entra.
function loginLabel(u) {
  if (u.login_github && u.login_email) return "entra pelo GitHub ou com e-mail e senha";
  return u.login_github ? "entra pelo GitHub" : "entra com e-mail e senha";
}

function contaLabel(o) {
  return `${o.email} (${o.login_github ? "entra pelo GitHub" : "e-mail e senha"})`;
}
let activeFilter = "todos";

function formatDate(raw) {
  if (!raw) return "—";
  return new Date(raw).toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
}

function applyFilter() {
  const filtered = allUsers.filter(u => {
    if (activeFilter === "ativos")    return u.active;
    if (activeFilter === "suspensos") return !u.active;
    return true;
  });
  document.getElementById("users-count").textContent = `(${filtered.length})`;
  renderTable(filtered);
}

function renderTable(users) {
  const tbody = document.getElementById("users-tbody");
  const empty = document.getElementById("users-empty");
  const table = document.getElementById("users-table");
  tbody.innerHTML = "";

  if (!users.length) { table.style.display = "none"; empty.hidden = false; return; }
  table.style.display = ""; empty.hidden = true;

  users.forEach(u => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td data-label="Nome">${u.nome ? escapeHtml(`${u.nome} ${u.sobrenome ?? ""}`.trim()) : "—"}</td>
      <td data-label="E-mail">${escapeHtml(u.email)}<br><small style="color:var(--muted)">${loginLabel(u)}</small></td>
      <td data-label="Nível"><span class="badge badge-muted">${NIVEL_LABEL[u.nivel] ?? "—"}</span></td>
      <td data-label="GitHub">${u.github_login ? `<a href="https://github.com/${u.github_login}" target="_blank" rel="noopener" style="color:var(--blue)">@${u.github_login}</a>` : "—"}${u.outras_contas.length
        ? `<br><small style="color:var(--yellow)">⚠ mesmo GitHub de: ${u.outras_contas.map(o => escapeHtml(contaLabel(o))).join(", ")}</small>`
        : ""}</td>
      <td data-label="Plano">
        <select class="form-select" style="padding:4px 24px 4px 8px;font-size:.78rem" onchange="changePlan(${u.id}, this.value)">
          <option value="dev_free" ${u.plan_code === "dev_free" ? "selected" : ""}>Gratuito</option>
          <option value="dev_pro"  ${u.plan_code === "dev_pro"  ? "selected" : ""}>PRO</option>
        </select>
      </td>
      <td data-label="Cadastro">${formatDate(u.created_at)}</td>
      <td data-label="Status"><span class="badge ${u.active ? "badge-green" : "badge-red"}">${u.active ? "Ativo" : "Suspenso"}</span></td>
      <td data-label="Ações">
        <button class="btn-icon ${u.active ? "" : "btn-toggle-on"}" title="${u.active ? "Suspender" : "Reativar"}"
          onclick="toggleStatus(${u.id}, ${!u.active})">
          ${u.active
            ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>`
            : `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`}
        </button>
      </td>`;
    tbody.appendChild(tr);
  });
}

document.querySelectorAll(".filter-chip").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".filter-chip").forEach(b => { b.classList.remove("active"); b.setAttribute("aria-pressed", "false"); });
    btn.classList.add("active"); btn.setAttribute("aria-pressed", "true");
    activeFilter = btn.dataset.f;
    applyFilter();
  });
});

async function toggleStatus(id, newActive) {
  try {
    const res = await fetch(`/api/admin/users/${id}`, {
      method: "PATCH", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ active: newActive }),
    });
    if (!res.ok) throw new Error();
    showToast(newActive ? "Desenvolvedor reativado." : "Desenvolvedor suspenso.");
    await reload();
  } catch {
    showToast("Erro ao atualizar. Tente novamente.", true);
  }
}

async function reload() {
  const res = await fetch("/api/admin/users");
  if (!res.ok) return;
  allUsers = await res.json();
  applyFilter();
}

async function changePlan(id, planCode) {
  // Se a pessoa tem outra conta com o mesmo GitHub, o plano trocado só nesta
  // não vale quando ela entra pela outra — oferece aplicar em todas.
  const user   = allUsers.find(u => u.id === id);
  const outras = (user?.outras_contas ?? []).filter(o => o.plan_code !== planCode);
  const ids    = [id];
  if (outras.length && confirm(
    `Esta pessoa parece ter outra(s) conta(s) com o mesmo GitHub:\n` +
    outras.map(o => `• ${contaLabel(o)}`).join("\n") +
    `\n\nAplicar o plano ${PLAN_LABEL[planCode]} nelas também? ` +
    `Se não, ela continua no plano antigo quando entrar por essa(s) conta(s).`
  )) {
    ids.push(...outras.map(o => o.id));
  }

  try {
    for (const target of ids) {
      const res = await fetch(`/api/admin/users/${target}/plan`, {
        method: "PATCH", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ plan_code: planCode }),
      });
      if (!res.ok) throw new Error();
    }
    showToast(ids.length > 1 ? `Plano atualizado em ${ids.length} contas.` : "Plano atualizado.");
  } catch {
    showToast("Erro ao atualizar o plano.", true);
  }
  // Recarrega mesmo no erro, pra o seletor não ficar mostrando um plano que não foi salvo.
  await reload();
}

let toastTimer = null;
function showToast(msg, isErr = false) {
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.style.borderColor = isErr ? "rgba(248,81,73,.35)" : "var(--border-lite)";
  el.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
}

async function init() {
  try {
    await reload();
    document.getElementById("loading").hidden = true;
    document.getElementById("content").hidden = false;
  } catch (err) {
    console.error(err);
    document.getElementById("loading").innerHTML = `
      <section style="text-align:center">
        <p style="color:var(--red);margin-bottom:10px">Erro ao carregar os desenvolvedores.</p>
        <a href="/admin/dashboard" style="color:var(--blue);font-size:.9rem">← Voltar ao painel</a>
      </section>`;
  }
}

init();
</script>

<%- include('partials/vlibras') %>
</body>
</html>
