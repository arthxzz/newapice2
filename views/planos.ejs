<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Escolha seu plano na Ápice." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <title>Ápice — Planos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <% if (userType === "empresa") { %>
  <link rel="stylesheet" href="/css/empresa-dashboard.css" />
  <% } else { %>
  <link rel="stylesheet" href="/css/dev.css" />
  <% } %>
  <link rel="stylesheet" href="/css/perfil.css" />
  <link rel="stylesheet" href="/css/assinatura.css" />
  <style>
    .plans-header { max-width: 760px; margin: 0 auto 2rem; text-align: center; }
    .plans-header h1 { font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; letter-spacing: -.02em; margin-bottom: .5rem; }
    .plans-header p { color: var(--muted); font-size: .92rem; }

    .plans-status { max-width: 900px; margin: 0 auto 1.25rem; }

    .plans-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem; max-width: 900px; margin: 0 auto;
    }

    .plan-card {
      display: flex; flex-direction: column; gap: 1rem;
      position: relative;
    }
    .plan-card.is-current { border-color: var(--accent-border); }
    .plan-card-current-badge {
      position: absolute; top: -11px; left: 1.5rem;
      background: var(--accent); color: #fff;
      font-size: .68rem; font-weight: 700; letter-spacing: .03em;
      padding: 3px 12px; border-radius: 99px;
    }

    .plan-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; }
    .plan-price { font-family: var(--font-display); font-size: 1.9rem; font-weight: 700; letter-spacing: -.02em; }
    .plan-price span { font-size: .8rem; font-weight: 500; color: var(--muted); }
    .plan-billing { color: var(--muted); font-size: .75rem; margin-top: -.6rem; }

    .plan-features { display: flex; flex-direction: column; gap: .55rem; flex: 1; margin: 0; padding: 0; list-style: none; }
    .plan-features li { display: flex; align-items: flex-start; gap: 8px; font-size: .85rem; color: var(--text); }
    .plan-features li.is-off { color: var(--muted); }
    .plan-features svg { flex-shrink: 0; margin-top: 2px; }
    .plan-features .ic-on  { color: var(--accent); }
    .plan-features .ic-off { color: var(--border-lite); }

    .plan-cta {
      display: block; width: 100%; padding: 11px; border-radius: var(--radius-sm);
      font-family: var(--font-display); font-weight: 700; font-size: .88rem; text-align: center;
      cursor: pointer; transition: all .15s; border: none; text-decoration: none;
    }
    .plan-cta.is-primary { background: var(--accent); color: #fff; }
    .plan-cta.is-primary:hover { background: var(--accent-hv); }
    .plan-cta.is-secondary { background: var(--bg-3); color: var(--text); border: 1px solid var(--border-lite); }
    .plan-cta.is-secondary:hover { border-color: var(--muted); }
    .plan-cta.is-current { background: var(--bg-3); color: var(--muted); cursor: default; border: 1px solid var(--border-lite); }

    .plan-annual { display: flex; flex-direction: column; gap: 4px; margin-top: .75rem; padding-top: .75rem; border-top: 1px solid var(--border); font-size: .78rem; color: var(--muted); }
    .plan-annual strong { color: var(--text); font-weight: 600; }
    .plan-annual-link { align-self: flex-start; color: var(--accent-text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .plans-footnote { max-width: 900px; margin: 1.5rem auto 0; text-align: center; color: var(--muted); font-size: .78rem; }

    @media (max-width: 640px) {
      .plans-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <% if (userType === "empresa") { %>
    <%- include('partials/header-company', { currentPage: 'planos' }) %>
  <% } else { %>
    <%- include('partials/header-dev', { currentPage: 'planos' }) %>
  <% } %>

<main class="page-content" id="main-content">

  <section class="sub-brick-loading" id="loading" role="status" aria-live="polite">
    <span class="sub-spinner" aria-hidden="true"></span>
    <p>Carregando planos...</p>
  </section>

  <article id="content" hidden>
    <header class="plans-header">
      <h1>Escolha o plano certo para você</h1>
      <p>Assinatura mensal no cartão de crédito, com cobrança automática. Cancele ou troque quando quiser.</p>
    </header>

    <div class="plans-status" id="plans-status"></div>

    <section class="plans-grid" id="plans-grid" aria-label="Planos disponíveis"></section>

    <p class="plans-footnote">Pagamentos processados pelo Mercado Pago. Os dados do cartão não passam pelos servidores do Ápice.</p>
  </article>
</main>

<footer class="site-footer">
  <p>&copy; <script>document.write(new Date().getFullYear())</script> Ápice.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script>
const FEATURE_LABEL = {
  roadmap_personalizado: "Roadmap com cursos e vídeos recomendados",
  destaque_perfil:       "Destaque do seu perfil para empresas",
  mentor_carreira:       "Mentor de carreira com IA, com simulação de entrevista técnica",
};

function formatPrice(cents) {
  if (cents === 0) return "Grátis";
  return (cents / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}
const fmtDate = iso => iso ? new Date(iso).toLocaleDateString("pt-BR", { timeZone: "America/Sao_Paulo" }) : "";

function iconOn() {
  return `<svg class="ic-on" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
}
function iconOff() {
  return `<svg class="ic-off" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
}

function renderFeatures(plan) {
  if (plan.features) {
    return Object.entries(FEATURE_LABEL).map(([key, label]) => {
      const on = Boolean(plan.features[key]);
      return `<li class="${on ? "" : "is-off"}">${on ? iconOn() : iconOff()} ${escapeHtml(label)}</li>`;
    }).join("");
  }
  // Planos de empresa: limite de vagas e recursos extras (config/plans.js)
  return (plan.benefits || []).map(b => `<li>${iconOn()} ${escapeHtml(b)}</li>`).join("");
}

// O botão de cada plano depende do plano efetivo e da assinatura paga:
// "Assinar" / "Trocar para este plano" levam ao checkout do Mercado Pago
// (/planos/:id/assinar); o plano assinado leva a Minha assinatura.
function ctaFor(plan, currentCode, subscription) {
  const live = subscription && (subscription.status === "authorized" || subscription.status === "paused");
  const subPlan = subscription && subscription.plan ? subscription.plan.code : null;
  const checkout = `/planos/${encodeURIComponent(plan.code)}/assinar`;

  if (plan.price_cents === 0) {
    if (plan.code === currentCode) return { label: "Plano atual", current: true };
    if (live) return { label: "Voltar ao gratuito", href: "/minha-assinatura", secondary: true };
    return { label: "Plano gratuito", current: true };
  }
  if (live && subPlan === plan.code) return { label: "Gerenciar assinatura", href: "/minha-assinatura", secondary: true };
  if (live) return { label: "Trocar para este plano", href: checkout };
  if (subscription && subscription.status === "cancelled" && subPlan === plan.code) {
    return { label: "Assinar novamente", href: checkout };
  }
  if (plan.code === currentCode) return { label: "Plano atual", current: true };
  return { label: "Assinar", href: checkout };
}

// Opção anual do plano pago: pagamento único (à vista ou parcelado).
function annualHtml(plan, maxParcelas, annual) {
  if (!plan.annual_price_cents) return "";
  const mensal = formatPrice(Math.round(plan.annual_price_cents / 12));
  const total = formatPrice(plan.annual_price_cents);
  const vigente = annual && annual.has_access && annual.plan && annual.plan.code === plan.code;
  const href = `/planos/${encodeURIComponent(plan.code)}/assinar?periodo=anual`;
  return `<div class="plan-annual">
      <span><strong>Anual: ${escapeHtml(mensal)}/mês</strong> — ${escapeHtml(total)} à vista ou em até ${maxParcelas}x sem juros</span>
      ${vigente
        ? `<span class="plan-billing">Seu anual vale até ${escapeHtml(fmtDate(annual.valid_until))}</span>`
        : `<a class="plan-annual-link" href="${escapeHtml(href)}">Pagar o ano</a>`}
    </div>`;
}

function renderPlans(plans, currentCode, subscription, maxParcelas, annual) {
  const grid = document.getElementById("plans-grid");
  grid.innerHTML = "";

  plans.forEach(plan => {
    const isCurrent = plan.code === currentCode;
    const cta = ctaFor(plan, currentCode, subscription);
    const ctaHtml = cta.href
      ? `<a class="plan-cta ${cta.secondary ? "is-secondary" : "is-primary"}" href="${escapeHtml(cta.href)}">${escapeHtml(cta.label)}</a>`
      : `<button type="button" class="plan-cta is-current" disabled>${escapeHtml(cta.label)}</button>`;

    const card = document.createElement("article");
    card.className = `card plan-card ${isCurrent ? "is-current" : ""}`;
    card.innerHTML = `
      ${isCurrent ? `<span class="plan-card-current-badge">Seu plano atual</span>` : ""}
      <span class="plan-name">${escapeHtml(plan.name)}</span>
      <span class="plan-price">${formatPrice(plan.price_cents)}${plan.price_cents > 0 ? "<span>/mês</span>" : ""}</span>
      ${plan.price_cents > 0 ? `<span class="plan-billing">Mensal: cobrado automaticamente todo mês</span>` : ""}
      <ul class="plan-features">${renderFeatures(plan)}</ul>
      ${ctaHtml}
      ${annualHtml(plan, maxParcelas, annual)}
    `;
    grid.appendChild(card);
  });
}

function renderStatus(subscription, checkoutAvailable, annual) {
  const box = document.getElementById("plans-status");
  const notices = [];

  if (!checkoutAvailable) {
    notices.push(`<div class="sub-notice sub-notice--warn"><div><strong>Assinaturas temporariamente indisponíveis.</strong> Tente novamente mais tarde.</div></div>`);
  }
  if (subscription) {
    const name = escapeHtml(subscription.plan ? subscription.plan.name : "");
    if (subscription.status === "authorized" && subscription.payment_issue) {
      notices.push(`<div class="sub-notice sub-notice--error"><div><strong>Problema na cobrança do plano ${name}:</strong> ${escapeHtml(subscription.payment_issue.message)}
        <div class="sub-notice-actions"><a class="btn-primary" href="/minha-assinatura">Atualizar cartão</a></div></div></div>`);
    } else if (subscription.status === "authorized") {
      const next = subscription.next_payment_date ? ` Próxima cobrança em <strong>${escapeHtml(fmtDate(subscription.next_payment_date))}</strong>.` : "";
      notices.push(`<div class="sub-notice sub-notice--ok"><div>Você assina o plano <strong>${name}</strong>.${next} <a href="/minha-assinatura" style="text-decoration:underline">Gerenciar assinatura</a></div></div>`);
    } else if (subscription.status === "pending") {
      notices.push(`<div class="sub-notice"><div>A assinatura do plano <strong>${name}</strong> está aguardando confirmação do Mercado Pago. <a href="/minha-assinatura" style="text-decoration:underline">Ver status</a></div></div>`);
    } else if (subscription.status === "cancelled" && subscription.has_access) {
      notices.push(`<div class="sub-notice"><div>Sua assinatura do plano <strong>${name}</strong> foi cancelada e dá acesso até <strong>${escapeHtml(fmtDate(subscription.paid_until))}</strong>.</div></div>`);
    }
  }
  if (annual && annual.has_access) {
    notices.push(`<div class="sub-notice sub-notice--ok"><div>Seu plano <strong>${escapeHtml(annual.plan.name)}</strong> anual vale até <strong>${escapeHtml(fmtDate(annual.valid_until))}</strong>. <a href="/minha-assinatura" style="text-decoration:underline">Minha assinatura</a></div></div>`);
  } else if (annual && ["pending", "in_process", "authorized"].includes(annual.status)) {
    notices.push(`<div class="sub-notice"><div>O pagamento do plano anual está em análise no Mercado Pago. <a href="/minha-assinatura" style="text-decoration:underline">Ver status</a></div></div>`);
  }
  box.innerHTML = notices.join("");
}

async function init() {
  try {
    const res = await fetch("/api/plans");
    if (res.status === 401) { window.location.href = "/login?next=/planos"; return; }
    if (!res.ok) throw new Error();
    const { plans, current_plan_code, subscription, annual, max_parcelas_anual, checkout_available } = await res.json();
    renderStatus(subscription, checkout_available, annual);
    renderPlans(plans, current_plan_code, subscription, max_parcelas_anual || 12, annual);
    document.getElementById("loading").hidden = true;
    document.getElementById("content").hidden = false;
  } catch (err) {
    console.error(err);
    document.getElementById("loading").innerHTML = `
      <section style="text-align:center">
        <p style="color:var(--red);margin-bottom:10px">Erro ao carregar os planos.</p>
        <a href="/dashboard" style="color:var(--blue);font-size:.9rem">← Voltar</a>
      </section>`;
  }
}

init();
</script>

</body>
</html>
