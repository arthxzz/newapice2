<%#
  header-dev.ejs — Navbar superior da área do desenvolvedor
  Requer locals: user, currentPage
  CSS: /css/header.css
%>

<a class="skip-link" href="#main-content">Ir para o conteúdo</a>

<header class="site-header site-header--dev" id="site-header" role="banner">

  <%# ── Logo ─────────────────────────────── %>
  <a href="/dashboard" class="site-logo" aria-label="Ápice — painel do desenvolvedor">
    <img src="/images/principal.webp" alt="Ápice" class="nav-logo__img"
         width="90" height="22" loading="eager" />
  </a>

  <%# ── Nav Desktop ────────────────────────── %>
  <nav class="header-nav" aria-label="Menu do desenvolvedor">

    <a href="/dashboard"
       class="header-link<% if (locals.currentPage === 'dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'dashboard') { %>aria-current="page"<% } %>>
      Dashboard
    </a>

    <a href="/vagas"
       class="header-link<% if (locals.currentPage === 'vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'vagas') { %>aria-current="page"<% } %>>
      Vagas
    </a>

    <a href="/repositorios"
       class="header-link<% if (locals.currentPage === 'repositorios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'repositorios') { %>aria-current="page"<% } %>>
      Repositórios
    </a>

    <a href="/meu-progresso"
       class="header-link<% if (locals.currentPage === 'progresso') { %> is-active<% } %>"
       <% if (locals.currentPage === 'progresso') { %>aria-current="page"<% } %>>
      Progresso
    </a>

    <a href="/roadmap"
       class="header-link<% if (locals.currentPage === 'roadmap') { %> is-active<% } %>"
       <% if (locals.currentPage === 'roadmap') { %>aria-current="page"<% } %>>
      Roadmap
    </a>

  </nav>

  <%# ── Direita: user menu + hamburger ───── %>
  <div class="header-right">

    <% if (locals.user) { %>
    <a href="/mensagens" class="header-msg-btn" aria-label="Mensagens" id="headerMsgBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="header-msg-badge" id="headerMsgBadge" hidden>0</span>
    </a>
    <div class="header-user">
      <div class="user-menu">
        <button class="user-menu-btn" id="userMenuBtn" type="button"
                aria-haspopup="true" aria-expanded="false"
                aria-controls="userMenuList" aria-label="Menu do usuário">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>" alt="" class="header-avatar"
                 width="26" height="26" loading="lazy" aria-hidden="true"/>
          <% } else { %>
            <span class="header-avatar-placeholder" aria-hidden="true">
              <%= (user.name || 'D').charAt(0).toUpperCase() %>
            </span>
          <% } %>
          <span class="header-username"><%= (user.name || '').split(' ')[0] %></span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <ul class="user-menu-list" id="userMenuList" role="menu">
          <li role="none">
            <a role="menuitem" href="/perfil">Meu perfil</a>
          </li>
          <li role="none">
            <a role="menuitem" href="/repositorios">Repositórios</a>
          </li>
          <li role="none">
            <a role="menuitem" href="/roadmap">Roadmap</a>
          </li>
          <li role="none">
            <a role="menuitem" href="/meu-progresso">Progresso</a>
          </li>
          <li role="separator" class="menu-divider" aria-hidden="true"></li>
          <li role="none">
            <a role="menuitem" href="/perfil#conta">Configurações</a>
          </li>
          <li role="none">
            <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="dark-mode"
                    aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
          </li>
          <li role="none">
            <button role="menuitem" type="button" class="menu-item-toggle" data-a11y="high-contrast"
                    aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
          </li>
          <li role="separator" class="menu-divider" aria-hidden="true"></li>
          <li role="none">
            <form method="POST" action="/auth/logout">
              <button role="menuitem" type="submit" class="menu-item--danger">Sair</button>
            </form>
          </li>
        </ul>
      </div>
    </div>
    <% } %>

    <%# ── Botão hamburger (aparece só no mobile) %>
    <button class="hamburger-btn" id="hamburgerBtn" type="button"
            aria-label="Abrir menu de navegação" aria-expanded="false"
            aria-controls="mobileDrawer">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

  </div>

</header>

<%# ═══ Mobile Drawer ════════════════════════ %>
<div class="mobile-drawer" id="mobileDrawer"
     role="dialog" aria-modal="true" aria-label="Menu de navegação" aria-hidden="true">

  <div class="drawer-head">
    <a href="/dashboard" class="site-logo" tabindex="-1" aria-hidden="true">
      <img src="/images/principal.webp" alt="Ápice" height="22" width="90" loading="eager" />
    </a>
    <button class="drawer-close-btn" id="drawerClose" type="button" aria-label="Fechar menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navegação principal">

    <a href="/dashboard"
       class="drawer-link<% if (locals.currentPage === 'dashboard') { %> is-active<% } %>"
       <% if (locals.currentPage === 'dashboard') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      Dashboard
    </a>

    <a href="/vagas"
       class="drawer-link<% if (locals.currentPage === 'vagas') { %> is-active<% } %>"
       <% if (locals.currentPage === 'vagas') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="7" width="20" height="14" rx="2"/>
        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
      </svg>
      Vagas
    </a>

    <a href="/repositorios"
       class="drawer-link<% if (locals.currentPage === 'repositorios') { %> is-active<% } %>"
       <% if (locals.currentPage === 'repositorios') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="6" y1="3" x2="6" y2="15"/>
        <circle cx="18" cy="6" r="3"/>
        <circle cx="6" cy="18" r="3"/>
        <path d="M18 9a9 9 0 0 1-9 9"/>
      </svg>
      Repositórios
    </a>

    <a href="/meu-progresso"
       class="drawer-link<% if (locals.currentPage === 'progresso') { %> is-active<% } %>"
       <% if (locals.currentPage === 'progresso') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="20" x2="18" y2="10"/>
        <line x1="12" y1="20" x2="12" y2="4"/>
        <line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
      Progresso
    </a>

    <a href="/roadmap"
       class="drawer-link<% if (locals.currentPage === 'roadmap') { %> is-active<% } %>"
       <% if (locals.currentPage === 'roadmap') { %>aria-current="page"<% } %>>
      <svg class="drawer-link-ico" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
      </svg>
      Roadmap
    </a>

  </nav>

  <% if (locals.user) { %>
  <div class="drawer-foot">
    <div class="drawer-user">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="" class="drawer-avatar"
             width="36" height="36" loading="lazy" />
      <% } else { %>
        <span class="drawer-avatar-ph">
          <%= (user.name || 'D').charAt(0).toUpperCase() %>
        </span>
      <% } %>
      <div class="drawer-user-info">
        <span class="drawer-user-name"><%= user.name || user.login || user.email %></span>
        <span class="drawer-user-role">Desenvolvedor</span>
      </div>
    </div>
    <div class="drawer-foot-links">
      <a href="/perfil" class="drawer-foot-link">Meu perfil</a>
      <a href="/perfil#conta" class="drawer-foot-link">Configurações</a>
      <button type="button" class="drawer-foot-link" data-a11y="dark-mode"
              aria-pressed="false" onclick="toggleDarkMode()">Modo escuro</button>
      <button type="button" class="drawer-foot-link" data-a11y="high-contrast"
              aria-pressed="false" onclick="toggleHighContrast()">Alto contraste</button>
      <form method="POST" action="/auth/logout">
        <button type="submit" class="drawer-foot-link drawer-foot-link--danger">Sair da conta</button>
      </form>
    </div>
  </div>
  <% } %>

</div>

<%# ═══ Overlay ═══════════════════════════════ %>
<div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>

<%# ═══ Bottom Nav Mobile (pill) ══════════════ %>
<nav class="bottom-nav bottom-nav--dev" aria-label="Navegação principal">

  <a href="/dashboard"
     class="bottom-nav-item<% if (locals.currentPage === 'dashboard') { %> is-active<% } %>"
     <% if (locals.currentPage === 'dashboard') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="3" width="7" height="7" rx="1.5"/>
      <rect x="14" y="14" width="7" height="7" rx="1.5"/>
      <rect x="3" y="14" width="7" height="7" rx="1.5"/>
    </svg>
    <span>Home</span>
  </a>

  <a href="/vagas"
     class="bottom-nav-item<% if (locals.currentPage === 'vagas') { %> is-active<% } %>"
     <% if (locals.currentPage === 'vagas') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="7" width="20" height="14" rx="2"/>
      <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
    </svg>
    <span>Vagas</span>
  </a>

  <a href="/meu-progresso"
     class="bottom-nav-item<% if (locals.currentPage === 'progresso') { %> is-active<% } %>"
     <% if (locals.currentPage === 'progresso') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="20" x2="18" y2="10"/>
      <line x1="12" y1="20" x2="12" y2="4"/>
      <line x1="6" y1="20" x2="6" y2="14"/>
    </svg>
    <span>Progresso</span>
  </a>

  <a href="/roadmap"
     class="bottom-nav-item<% if (locals.currentPage === 'roadmap') { %> is-active<% } %>"
     <% if (locals.currentPage === 'roadmap') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
    </svg>
    <span>Roadmap</span>
  </a>

  <a href="/perfil"
     class="bottom-nav-item<% if (locals.currentPage === 'perfil') { %> is-active<% } %>"
     <% if (locals.currentPage === 'perfil') { %>aria-current="page"<% } %>>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="8" r="4"/>
      <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
    </svg>
    <span>Perfil</span>
  </a>

</nav>

<script>
(function () {
  // ── Dropdown do usuário ──────────────────────
  const menuBtn  = document.getElementById('userMenuBtn');
  const menuList = document.getElementById('userMenuList');

  function closeMenu() {
    if (!menuBtn || !menuList) return;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuList.classList.remove('is-open');
  }
  function openMenu() {
    menuBtn.setAttribute('aria-expanded', 'true');
    menuList.classList.add('is-open');
    menuList.querySelector('[role="menuitem"]')?.focus();
  }

  if (menuBtn && menuList) {
    menuBtn.addEventListener('click', () =>
      menuBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
    );
    document.addEventListener('click', e => {
      if (!menuBtn.contains(e.target) && !menuList.contains(e.target)) closeMenu();
    });
  }

  // ── Mobile drawer ────────────────────────────
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const drawer       = document.getElementById('mobileDrawer');
  const overlay      = document.getElementById('drawerOverlay');
  const closeBtn     = document.getElementById('drawerClose');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.add('is-open');
    overlay.classList.add('is-open');
    hamburgerBtn.classList.add('is-active');
    hamburgerBtn.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-open');
    hamburgerBtn?.classList.remove('is-active');
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', () =>
    hamburgerBtn.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer()
  );
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeMenu(); closeDrawer(); }
  });

  // ── Badge de mensagens não lidas ──────────────
  const msgBadge = document.getElementById('headerMsgBadge');
  if (msgBadge) {
    fetch('/api/messages/unread-count')
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (!data || !data.count) return;
        msgBadge.textContent = data.count > 99 ? '99+' : data.count;
        msgBadge.hidden = false;
      })
      .catch(() => {});
  }
})();
</script>
<script src="/js/accessibility.js" defer></script>
