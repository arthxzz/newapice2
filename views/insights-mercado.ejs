<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Insights sobre as tecnologias mais demandadas nas vagas da Ápice." />
  <title>Ápice — Insights de mercado</title>
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Ápice" />
  <meta property="og:url"         content="https://newapice22.onrender.com/insights-mercado" />
  <meta property="og:title"       content="Insights de mercado — Ápice" />
  <meta property="og:description" content="Veja quais tecnologias estão mais em alta nas vagas cadastradas na Ápice." />
  <meta property="og:locale"      content="pt_BR" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary" />
  <meta name="twitter:title"       content="Insights de mercado — Ápice" />
  <meta name="twitter:description" content="Tecnologias mais demandadas nas vagas cadastradas na Ápice." />

  <!-- Canonical -->
  <link rel="canonical" href="https://newapice22.onrender.com/insights-mercado" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
</head>
<body>

<% if (locals.user) { %>
  <%- include('partials/header-dev', { currentPage: 'insights-mercado' }) %>
<% } else { %>
  <%- include('partials/header') %>
<% } %>

  <main class="page-content" id="main-content" style="max-width:760px;margin:0 auto">

    <div class="repos-page-header">
      <div>
        <h1 class="repos-page-title">Insights de mercado</h1>
        <p class="repos-page-sub">Tecnologias mais demandadas nas vagas cadastradas na Ápice, atualizado periodicamente.</p>
      </div>
    </div>

    <!-- SEO (QA-020): com um resumo já cacheado, o conteúdo sai pronto no
         HTML inicial — sem isso, a página inteira dependia do fetch
         client-side pra existir texto de verdade. -->
    <div id="state-loading" <%= insights ? "hidden" : "" %>>
      <p style="color:var(--muted);text-align:center;padding:40px">Carregando...</p>
    </div>

    <div id="state-empty" hidden>
      <div class="repos-empty">
        <h3>Ainda não há dados suficientes</h3>
        <p>Volte em breve — assim que houver vagas com skills cadastradas, os insights aparecem aqui.</p>
      </div>
    </div>

    <div id="state-content" <%= insights ? "" : "hidden" %>>
      <div class="dev-card" style="margin-bottom:20px">
        <p id="resumo-text" style="font-size:.95rem;line-height:1.7"><%= insights ? insights.resumo : "" %></p>
        <p id="gerado-em" style="font-size:.75rem;color:var(--muted);margin-top:12px"><%
          if (insights && insights.gerado_em) { %>Atualizado em <%= new Date(insights.gerado_em).toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" }) %><% } %></p>
      </div>

      <h2 style="font-size:1rem;margin-bottom:12px">Tecnologias mais demandadas</h2>
      <div id="tech-list" style="display:flex;flex-wrap:wrap;gap:8px"><%
        if (insights) { (insights.tecnologias_top || []).forEach(t => { %><span class="skill-tag"><%= t.nome %><% if (t.vagas) { %> · <%= t.vagas %> vaga<%= t.vagas !== 1 ? "s" : "" %><% } %></span><%
        }) } %></div>
    </div>

  </main>

  <script>
  (function () {
    'use strict';
    const $ = id => document.getElementById(id);

    function escHtml(str) {
      return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    async function load() {
      // Já veio pronto do servidor (QA-020) — evita refazer o fetch à toa.
      if (!$('state-content').hidden) return;
      try {
        const res  = await fetch('/api/ai/insights-mercado');
        const data = await res.json();

        $('state-loading').hidden = true;

        if (res.status === 404) { $('state-empty').hidden = false; return; }
        if (!res.ok) throw new Error(data.error || 'Erro ao carregar insights.');

        $('resumo-text').textContent = data.resumo;
        $('gerado-em').textContent   = data.gerado_em
          ? 'Atualizado em ' + new Date(data.gerado_em).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })
          : '';

        $('tech-list').innerHTML = (data.tecnologias_top || []).map(t => `
          <span class="skill-tag">${escHtml(t.nome)}${t.vagas ? ` · ${t.vagas} vaga${t.vagas !== 1 ? 's' : ''}` : ''}</span>
        `).join('');

        $('state-content').hidden = false;
      } catch (err) {
        $('state-loading').hidden = true;
        $('state-empty').hidden = false;
      }
    }

    load();
  })();
  </script>

</body>
</html>
