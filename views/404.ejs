<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <title>Ápice — Página não encontrada</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; background:var(--bg); font-family:var(--font-body); --font-mono: 'Courier New', monospace; }
    .error-page { text-align:center; max-width:480px; padding:2rem; }
    .error-code { font-family:var(--font-mono); font-size:6rem; font-weight:700; color:var(--border-lite); line-height:1; margin-bottom:1rem; }
    .error-title { font-size:1.4rem; font-weight:600; color:var(--text); margin-bottom:.75rem; }
    .error-desc { color:var(--muted); font-size:.9rem; margin-bottom:2rem; line-height:1.6; }
    .error-actions { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }

    /* .btn-primary/.btn-ghost — página isolada, sem outro CSS de página
       carregado, então definidos aqui em vez de puxar landing.css/auth.css */
    .btn-primary {
      display:inline-flex; align-items:center; gap:8px;
      background:var(--teal); color:#06210f; font-weight:700;
      font-family:var(--font-display); font-size:.875rem; letter-spacing:.01em;
      padding:13px 26px; border-radius:99px; text-decoration:none;
      transition:background .2s ease, transform .2s ease, box-shadow .2s ease;
    }
    .btn-primary:hover { background:var(--teal-hv); transform:translateY(-1px) scale(1.02); box-shadow:0 8px 28px var(--teal-glow); }
    .btn-primary:focus-visible { outline:2px solid var(--accent-hv); outline-offset:3px; }

    .btn-ghost {
      display:inline-flex; align-items:center; gap:8px;
      background:transparent; color:var(--text);
      font-family:var(--font-display); font-size:.875rem; font-weight:500;
      padding:12px 24px; border-radius:99px; border:1px solid var(--border-lite);
      text-decoration:none; cursor:pointer;
      transition:border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease;
    }
    .btn-ghost:hover { border-color:var(--teal-border); background:var(--teal-dim); transform:translateY(-1px); }
    .btn-ghost:focus-visible { outline:2px solid var(--accent-hv); outline-offset:3px; }
  </style>
</head>
<body>
  <main class="error-page" role="main">
    <p class="error-code" aria-hidden="true">404</p>
    <h1 class="error-title">Página não encontrada</h1>
    <p class="error-desc">A página que você está procurando não existe ou foi movida.</p>
    <nav class="error-actions" aria-label="Opções de navegação">
      <a href="/" class="btn-primary">Ir para o início</a>
      <a href="/vagas" class="btn-ghost">Ver vagas</a>
    </nav>
  </main>
</body>
</html>
